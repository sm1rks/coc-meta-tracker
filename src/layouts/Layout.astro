---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  playersAnalyzed?: number;
  attacksAnalyzed?: number;
  lastUpdated?: string;
}

const { title = "Clash Meta Tracker - Legends", playersAnalyzed = 0, attacksAnalyzed = 0, lastUpdated = '' } = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Stats" },
  { href: "/armies", label: "Armies" },
  { href: "/players", label: "Top 200" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-coc-bg relative">
    <!-- Vibrant decorative background -->
    <div class="fixed inset-0 bg-gradient-to-br from-coc-blue/20 to-coc-gold/10 -z-10"></div>
    
    <header class="bg-gradient-to-b from-coc-dark to-slate-800 border-b-8 border-coc-gold shadow-2xl relative overflow-hidden">
      <div class="absolute -right-20 -top-20 w-64 h-64 bg-coc-gold/20 rounded-full blur-3xl transform-gpu"></div>
      <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-coc-blue/20 rounded-full blur-3xl transform-gpu"></div>
      
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 relative z-10 p-6 pb-4">
        <div class="flex items-center gap-4 md:gap-6">
          <div class="w-16 h-16 md:w-20 md:h-20 bg-gradient-to-tr from-coc-gold to-yellow-300 rounded-2xl shadow-inner border-4 border-white/20 flex items-center justify-center transform -rotate-6 transition-transform hover:rotate-0 shrink-0 transform-gpu">
            <span class="text-3xl md:text-4xl">🛡️</span>
          </div>
          <div>
            <h1 class="text-3xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-coc-gold to-yellow-200 drop-shadow-sm tracking-tight m-0">
              META TRACKER
            </h1>
            <div class="text-coc-panel/80 font-bold tracking-widest text-[10px] md:text-sm mt-0.5 md:mt-1 uppercase">Legend League • Season Top 200</div>
          </div>
        </div>
        
        {(playersAnalyzed > 0 || attacksAnalyzed > 0) && (
          <div class="bg-black/40 backdrop-blur-md px-4 md:px-6 py-2 md:py-3 rounded-2xl border border-white/10 text-center shadow-inner inline-block w-full md:w-auto">
            <div class="flex gap-4 md:gap-6 items-center justify-center">
              <div>
                <div class="text-coc-gold font-black text-2xl md:text-3xl leading-none">{playersAnalyzed}</div>
                <div class="text-white/70 text-[9px] md:text-[10px] font-bold uppercase tracking-widest mt-1">Players Analyzed</div>
              </div>
              <div class="w-px bg-white/10 h-8 md:h-10"></div>
              <div>
                <div class="text-coc-gold font-black text-2xl md:text-3xl leading-none">{attacksAnalyzed}</div>
                <div class="text-white/70 text-[9px] md:text-[10px] font-bold uppercase tracking-widest mt-1">Attacks Analyzed</div>
              </div>
            </div>
            {lastUpdated && (
              <div class="mt-3 pt-2 border-t border-white/10 text-white/40 text-[9px] font-mono uppercase tracking-widest" id="layoutLastUpdated" data-timestamp={lastUpdated}>
                Updated: {lastUpdated}
              </div>
            )}
          </div>
        )}
      </div>

      <!-- Navigation Bar -->
      <nav class="max-w-6xl mx-auto px-6 pb-0 flex flex-wrap gap-2 md:gap-4 justify-center md:justify-start relative z-10">
        {navLinks.map((link) => {
          const base = import.meta.env.BASE_URL.replace(/\/$/, '');
          const resolvedHref = base + (link.href === '/' ? '' : link.href) || '/';
          const normalizedPath = currentPath.replace(/\/$/, '') || '/';
          const isActive = normalizedPath === resolvedHref || (link.href !== '/' && normalizedPath.startsWith(resolvedHref));
          return (
            <a 
              href={resolvedHref}
              data-astro-prefetch="hover"
              class={`px-4 md:px-6 py-2.5 md:py-3 font-black uppercase tracking-wider text-xs md:text-sm rounded-t-xl transition-all duration-300 transform origin-bottom ${
                isActive 
                  ? 'bg-coc-panel text-coc-dark shadow-[0_-4px_15px_rgba(0,0,0,0.3)] scale-105 z-10 border-b-0' 
                  : 'bg-black/20 text-white/60 hover:bg-black/40 hover:text-white border border-transparent hover:border-white/10'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </header>

    <main class="max-w-6xl mx-auto p-4 md:p-6 mt-4">
      <slot />
    </main>

    <script>
      document.addEventListener('astro:page-load', () => {
        const updatedEl = document.getElementById('layoutLastUpdated');
        const timestamp = updatedEl?.getAttribute('data-timestamp');
        if (timestamp && updatedEl) {
          const d = new Date(timestamp);
          updatedEl.textContent = `Updated:\n${d.toLocaleDateString()} ${d.toLocaleTimeString()}`;
        }
      });

      document.addEventListener("visibilitychange", async () => {
        const currentUpdatedEl = document.getElementById('layoutLastUpdated');
        const currentTimestamp = currentUpdatedEl?.getAttribute('data-timestamp');
        if (document.visibilityState === "visible" && currentTimestamp) {
          try {
            const res = await fetch(window.location.href, { cache: "no-store" });
            const text = await res.text();
            const match = text.match(/data-timestamp="([^"]+)"/);
            if (match && match[1]) {
              const fetchedTime = new Date(match[1]).getTime();
              const currentTime = new Date(currentTimestamp).getTime();
              if (fetchedTime > currentTime) {
                window.location.reload();
              }
            }
          } catch (e) {
            console.error("Failed to check for updates", e);
          }
        }
      });
    </script>
  </body>
</html>
