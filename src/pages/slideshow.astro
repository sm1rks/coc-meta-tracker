  <script src="https://cdnjs.cloudflare.com/ajax/libs/html-to-image/1.11.11/html-to-image.min.js" referrerpolicy="no-referrer"></script>
  
  <script>
    const seasonInput = document.getElementById('input-season-date');
    const subtitleDisplay = document.getElementById('slide-subtitle-display');
    const selectTheme = document.getElementById('select-theme');
    const rangeScale = document.getElementById('range-scale');
    const scaleLabel = document.getElementById('scale-label');
    const slideCanvas = document.getElementById('slide-canvas');
    const scalerWrapper = document.getElementById('canvas-scaler-wrapper');
    const slideTabs = document.getElementById('slide-tabs');
    const btnExport = document.getElementById('btn-export');
    const btnExportAll = document.getElementById('btn-export-all');

    seasonInput?.addEventListener('input', (e) => {
      if (subtitleDisplay && e.target) {
        subtitleDisplay.textContent = (e.target as HTMLInputElement).value;
      }
    });

    selectTheme?.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      if (slideCanvas) {
        slideCanvas.className = slideCanvas.className.replace(/\btheme-\w+/g, '');
        slideCanvas.classList.add('theme-' + target.value);
      }
    });

    rangeScale?.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      if (scaleLabel && scalerWrapper) {
        const percentage = Math.round(parseFloat(target.value) * 100);
        scaleLabel.textContent = percentage + '%';
        scalerWrapper.style.transform = 'scale(' + target.value + ')';
      }
    });
    
    if (scalerWrapper && rangeScale) {
      scalerWrapper.style.transform = 'scale(' + (rangeScale as HTMLInputElement).value + ')';
    }

    slideTabs?.addEventListener('click', (e) => {
      const targetButton = (e.target as HTMLElement).closest('button');
      if (!targetButton || !slideCanvas) return;
      
      const slideNum = targetButton.getAttribute('data-slide');
      
      slideTabs.querySelectorAll('button').forEach(btn => {
        btn.className = "flex items-center justify-between text-left text-xs font-black uppercase py-2.5 px-3 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-all";
      });
      targetButton.className = "active flex items-center justify-between text-left text-xs font-black uppercase py-2.5 px-3 rounded-lg bg-blue-600 text-white transition-all shadow-sm";

      slideCanvas.className = slideCanvas.className.replace(/\bshow-\d+/g, '');
      slideCanvas.classList.add('show-' + slideNum);
    });

    // Single PNG export with CORS and font fixes
    btnExport?.addEventListener('click', async () => {
      if (!slideCanvas || !(window as any).htmlToImage) {
        alert("Image export library not loaded or canvas missing.");
        return;
      }
      
      btnExport.setAttribute('disabled', 'true');
      const originalText = btnExport.innerHTML;
      btnExport.innerHTML = '<span>⏳ Renders slide...</span>';
      
      try {
        const activeTab = slideTabs?.querySelector('button.active');
        const slideNum = activeTab ? activeTab.getAttribute('data-slide') : '1';
        
        const dataUrl = await (window as any).htmlToImage.toPng(slideCanvas, {
          pixelRatio: 2,
          cacheBust: true,
          fontEmbedCSS: "",
          imagePlaceholder: "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=",
          style: {
            transform: 'scale(1)',
            transformOrigin: 'top left',
            boxShadow: 'none',
            borderWidth: '12px'
          }
        });
        
        const link = document.createElement('a');
        link.download = 'Legend_Meta_Recap_Slide_' + slideNum + '.png';
        link.href = dataUrl;
        link.click();
      } catch (err) {
        console.error("Export failed", err);
        alert("Export failed: " + err);
      } finally {
        btnExport.removeAttribute('disabled');
        btnExport.innerHTML = originalText;
      }
    });

    // Batch exporter for all 3 slides sequentially
    btnExportAll?.addEventListener('click', async () => {
      if (!slideCanvas || !(window as any).htmlToImage || !slideTabs) {
        alert("Image export library not loaded or canvas missing.");
        return;
      }
      
      btnExportAll.setAttribute('disabled', 'true');
      const originalText = btnExportAll.innerHTML;
      
      try {
        const activeTab = slideTabs.querySelector('button.active');
        const originalSlideNum = activeTab ? activeTab.getAttribute('data-slide') : '1';
        
        const sleep = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
        
        for (let slideNum = 1; slideNum <= 3; slideNum++) {
          btnExportAll.innerHTML = `<span>⏳ Exporting ${slideNum}/3...</span>`;
          
          // Switch slide tab active styling
          slideTabs.querySelectorAll('button').forEach(btn => {
            const num = btn.getAttribute('data-slide');
            if (num === String(slideNum)) {
              btn.className = "active flex items-center justify-between text-left text-xs font-black uppercase py-2.5 px-3 rounded-lg bg-blue-600 text-white transition-all shadow-sm";
            } else {
              btn.className = "flex items-center justify-between text-left text-xs font-black uppercase py-2.5 px-3 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-all";
            }
          });
          
          // Show canvas slide
          slideCanvas.className = slideCanvas.className.replace(/\bshow-\d+/g, '');
          slideCanvas.classList.add('show-' + slideNum);
          
          // Wait for browser layout rendering
          await sleep(150);
          
          const dataUrl = await (window as any).htmlToImage.toPng(slideCanvas, {
            pixelRatio: 2,
            cacheBust: true,
            fontEmbedCSS: "",
            imagePlaceholder: "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=",
            style: {
              transform: 'scale(1)',
              transformOrigin: 'top left',
              boxShadow: 'none',
              borderWidth: '12px'
            }
          });
          
          const link = document.createElement('a');
          link.download = 'Legend_Meta_Recap_Slide_' + slideNum + '.png';
          link.href = dataUrl;
          link.click();
          
          // Small pause between downloads to avoid browser blockages
          await sleep(150);
        }
        
        // Restore original slide view
        slideTabs.querySelectorAll('button').forEach(btn => {
          const num = btn.getAttribute('data-slide');
          if (num === originalSlideNum) {
            btn.className = "active flex items-center justify-between text-left text-xs font-black uppercase py-2.5 px-3 rounded-lg bg-blue-600 text-white transition-all shadow-sm";
          } else {
            btn.className = "flex items-center justify-between text-left text-xs font-black uppercase py-2.5 px-3 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-all";
          }
        });
        slideCanvas.className = slideCanvas.className.replace(/\bshow-\d+/g, '');
        slideCanvas.classList.add('show-' + originalSlideNum);
        
      } catch (err) {
        console.error("Batch export failed", err);
        alert("Batch export failed: " + err);
      } finally {
        btnExportAll.removeAttribute('disabled');
        btnExportAll.innerHTML = originalText;
      }
    });
  </script>
</body>
</html>
