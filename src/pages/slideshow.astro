---
import { getMetaData } from '../utils/dataUtils';
import type { MetaData } from '../types';
import { getHeroIcon, getEqIcon, getPetIcon, getSiegeMachineIcon, getTroopIcon, getSpellIcon } from '../utils/iconUtils';
import '../styles/global.css';

const metaData = getMetaData() as MetaData;

if (!import.meta.env.DEV) {
  return new Response("Not Found", { status: 404 });
}

const heroes = [...(metaData?.heroes || [])].sort((a, b) => b.usage - a.usage);
const equipments = metaData?.equipments || [];
const combos = metaData?.combos || [];
const pets = metaData?.pets || [];

// Helper functions for Slide 1
const getHeroEquipments = (heroName: string) => equipments.filter(eq => eq.hero === heroName).sort((a, b) => b.usage - a.usage).slice(0, 5);
const getHeroCombos = (heroName: string) => combos.filter(c => c.hero === heroName).sort((a, b) => b.usage - a.usage).slice(0, 3);
const getHeroPets = (heroName: string) => pets.filter(p => p.hero === heroName).sort((a, b) => b.usage - a.usage).slice(0, 3);

// Slide 1 primary heroes
const primaryHeroesData = heroes.slice(0, 4).map((hero: any) => {
  let heroColor = "bg-blue-600";
  if (hero.name === "Grand Warden") heroColor = "bg-blue-600";
  else if (hero.name === "Dragon Duke") heroColor = "bg-red-800";
  else if (hero.name === "Archer Queen") heroColor = "bg-teal-700";
  else if (hero.name === "Barbarian King") heroColor = "bg-amber-600";
  
  return {
    name: hero.name,
    usage: hero.usage,
    heroColor,
    heroIcon: getHeroIcon(hero.name),
    equipments: getHeroEquipments(hero.name).map((eq: any) => ({
      name: eq.name,
      usage: eq.usage,
      icon: getEqIcon(eq.name),
    })),
    combos: getHeroCombos(hero.name).map((c: any) => ({
      name: c.name,
      usage: c.usage,
      eqParts: c.name.split(' + ').map((part: string) => ({
        name: part,
        icon: getEqIcon(part),
      })),
    })),
    pets: getHeroPets(hero.name).map((p: any) => ({
      name: p.name,
      usage: p.usage,
      icon: getPetIcon(p.name),
    })),
  };
});

// Helper to preprocess single hero for Slide 1 (supporting cast)
const preprocessHeroSlide1 = (heroName: string, bgColor: string) => {
  const hero = heroes.find(h => h.name === heroName);
  if (!hero) return null;
  return {
    name: hero.name,
    usage: hero.usage,
    bgColor,
    heroIcon: getHeroIcon(hero.name),
    equipments: getHeroEquipments(hero.name).map((eq: any) => ({
      name: eq.name,
      usage: eq.usage,
      icon: getEqIcon(eq.name),
    })),
    combos: getHeroCombos(hero.name).map((c: any) => ({
      name: c.name,
      usage: c.usage,
      eqParts: c.name.split(' + ').map((part: string) => ({
        name: part,
        icon: getEqIcon(part),
      })),
    })),
    pets: getHeroPets(hero.name).map((p: any) => ({
      name: p.name,
      usage: p.usage,
      icon: getPetIcon(p.name),
    })),
  };
};

const minionPrinceData = preprocessHeroSlide1("Minion Prince", "bg-indigo-950");
const royalChampionData = preprocessHeroSlide1("Royal Champion", "bg-purple-800");

// Slide 1 supporting lists
const superTroops = [...(metaData?.superTroops || [])].sort((a, b) => b.usage - a.usage).slice(0, 8);
const siegeMachines = [...(metaData?.siegeMachines || [])].sort((a, b) => b.usage - a.usage).slice(0, 8);

const superTroopsData = superTroops.map((t: any) => ({
  name: t.name,
  usage: t.usage,
  icon: getTroopIcon(t.name),
}));

const siegeMachinesData = siegeMachines.map((m: any) => ({
  name: m.name,
  usage: m.usage,
  icon: getSiegeMachineIcon(m.name),
}));

// Slide 2 lists (Top 10 Armies)
const armies = [...(metaData?.armies || [])].sort((a, b) => b.usage - a.usage).slice(0, 10);

const armiesData = armies.map((army: any) => ({
  name: army.name,
  usage: army.usage,
  battlesCount: army.battlesCount,
  playerCount: army.playerCount,
  topHeroes: (army.topHeroes || []).map((h: any) => ({
    name: h.name,
    heroIcon: getHeroIcon(h.name),
    petIcon: h.pet ? getPetIcon(h.pet) : null,
    petName: h.pet || null,
    eqList: (h.equipment ? h.equipment.split(' + ') : []).map((eqName: string) => ({
      name: eqName,
      icon: getEqIcon(eqName),
    })),
  })),
  topSiegeMachine: army.topSiegeMachine || null,
  topSiegeMachineIcon: army.topSiegeMachine ? getSiegeMachineIcon(army.topSiegeMachine) : null,
  topSecondaryTroops: (army.topSecondaryTroops || []).map((tName: string) => ({
    name: tName,
    icon: getTroopIcon(tName),
  })),
}));

// Slide 3 lists (Leaderboard Top 10)
const topPlayers = [...(metaData?.topPlayers || [])].sort((a, b) => a.rank - b.rank).slice(0, 10);

const topPlayers1to10Data = topPlayers.map((player: any) => ({
  rank: player.rank,
  name: player.name,
  clanBadge: player.clanBadge || null,
  clanName: player.clanName || 'No Clan',
  armyType: player.armyType,
  trophies: player.trophies,
  siegeMachine: player.siegeMachine || null,
  siegeMachineIcon: player.siegeMachine ? getSiegeMachineIcon(player.siegeMachine) : null,
  heroes: (player.heroes || []).map((h: any) => ({
    hero: h.hero,
    heroIcon: getHeroIcon(h.hero),
    pet: h.pet || null,
    petIcon: h.pet ? getPetIcon(h.pet) : null,
    eqList: (h.combo ? h.combo.split(' + ') : []).map((eqName: string) => ({
      name: eqName,
      icon: getEqIcon(eqName),
    })),
  })),
  troops: (player.troops || []).map((t: any) => ({
    name: t.name,
    count: t.count,
    icon: getTroopIcon(t.name),
  })),
  spells: (player.spells || []).map((s: any) => ({
    name: s.name,
    count: s.count,
    icon: getSpellIcon(s.name),
  })),
  ccTroops: (player.ccTroops || []).map((t: any) => ({
    name: t.name,
    count: t.count,
    icon: getTroopIcon(t.name),
  })),
  ccSpells: (player.ccSpells || []).map((s: any) => ({
    name: s.name,
    count: s.count,
    icon: getSpellIcon(s.name),
  })),
}));

// Default metadata summary
const playersAnalyzed = metaData?.playersAnalyzed || 0;
const lastUpdated = metaData?.lastUpdated ? new Date(metaData.lastUpdated).toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' }) : '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reddit Slideshow Creator</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&display=swap" rel="stylesheet">
  
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #1e293b;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #475569;
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #64748b;
    }

    #slide-canvas {
      width: 1080px;
      height: 1350px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      border-width: 12px;
      border-style: solid;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      box-sizing: border-box;
      position: relative;
    }

    .slide-content-block {
      display: none;
      flex-direction: column;
      flex: 1;
      height: 100%;
      padding: 24px;
      box-sizing: border-box;
      justify-content: space-between;
    }
    #slide-canvas.show-1 #slide-content-1 { display: flex; }
    #slide-canvas.show-2 #slide-content-2 { display: flex; }
    #slide-canvas.show-3 #slide-content-3 { display: flex; }

    #slide-canvas.theme-clash {
      background-color: #f4e4c1;
      color: #4a2e0f;
      border-color: #603813;
    }
    #slide-canvas.theme-clash .slide-header {
      background: linear-gradient(to right, #dc2626, #ea580c);
      color: white;
      border-bottom: 6px solid #603813;
    }
    #slide-canvas.theme-clash .slide-footer {
      border-top: 4px solid #c4a481;
      background-color: #eadbb7;
      color: rgba(96, 56, 19, 0.7);
    }
    #slide-canvas.theme-clash .card {
      background-color: #fffbeb;
      border: 3px solid #c4a481;
      border-radius: 12px;
      color: #4a2e0f;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    #slide-canvas.theme-clash .progress-track {
      background-color: #eadbb7;
    }
    #slide-canvas.theme-clash .progress-fill {
      background: linear-gradient(to right, #3b82f6, #60a5fa);
    }
    #slide-canvas.theme-clash .progress-fill-green {
      background: linear-gradient(to right, #10b981, #34d399);
    }
    #slide-canvas.theme-clash .progress-fill-orange {
      background: linear-gradient(to right, #f97316, #fb923c);
    }

    #slide-canvas.theme-dark {
      background-color: #0f172a;
      color: #f8fafc;
      border-color: #1e293b;
    }
    #slide-canvas.theme-dark .slide-header {
      background: linear-gradient(to right, #1e3a8a, #0f172a);
      color: white;
      border-bottom: 6px solid #f59e0b;
    }
    #slide-canvas.theme-dark .slide-footer {
      border-top: 4px solid #334155;
      background-color: #020617;
      color: #94a3b8;
    }
    #slide-canvas.theme-dark .card {
      background-color: #1e293b;
      border: 3px solid #334155;
      border-radius: 12px;
      color: #f8fafc;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }
    #slide-canvas.theme-dark .progress-track {
      background-color: #334155;
    }
    #slide-canvas.theme-dark .progress-fill {
      background: linear-gradient(to right, #38bdf8, #0ea5e9);
    }
    #slide-canvas.theme-dark .progress-fill-green {
      background: linear-gradient(to right, #10b981, #059669);
    }
    #slide-canvas.theme-dark .progress-fill-orange {
      background: linear-gradient(to right, #f59e0b, #d97706);
    }

    #slide-canvas.theme-purple {
      background-color: #1e1b4b;
      color: #f8fafc;
      border-color: #312e81;
    }
    #slide-canvas.theme-purple .slide-header {
      background: linear-gradient(to right, #4c1d95, #1e1b4b);
      color: white;
      border-bottom: 6px solid #c084fc;
    }
    #slide-canvas.theme-purple .slide-footer {
      border-top: 4px solid #4338ca;
      background-color: #090526;
      color: #cbd5e1;
    }
    #slide-canvas.theme-purple .card {
      background-color: #312e81;
      border: 3px solid #4338ca;
      border-radius: 12px;
      color: #f8fafc;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }
    #slide-canvas.theme-purple .progress-track {
      background-color: #4338ca;
    }
    #slide-canvas.theme-purple .progress-fill {
      background: linear-gradient(to right, #c084fc, #a855f7);
    }
    #slide-canvas.theme-purple .progress-fill-green {
      background: linear-gradient(to right, #34d399, #059669);
    }
    #slide-canvas.theme-purple .progress-fill-orange {
      background: linear-gradient(to right, #fb923c, #ea580c);
    }

    #slide-canvas.theme-green {
      background-color: #022c22;
      color: #f0fdfa;
      border-color: #0f766e;
    }
    #slide-canvas.theme-green .slide-header {
      background: linear-gradient(to right, #065f46, #022c22);
      color: white;
      border-bottom: 6px solid #2dd4bf;
    }
    #slide-canvas.theme-green .slide-footer {
      border-top: 4px solid #115e59;
      background-color: #011c15;
      color: #99f6e4;
    }
    #slide-canvas.theme-green .card {
      background-color: #115e59;
      border: 3px solid #0f766e;
      border-radius: 12px;
      color: #f0fdfa;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }
    #slide-canvas.theme-green .progress-track {
      background-color: #0f766e;
    }
    #slide-canvas.theme-green .progress-fill {
      background: linear-gradient(to right, #2dd4bf, #0d9488);
    }
    #slide-canvas.theme-green .progress-fill-green {
      background: linear-gradient(to right, #34d399, #10b981);
    }
    #slide-canvas.theme-green .progress-fill-orange {
      background: linear-gradient(to right, #fb923c, #f97316);
    }
  </style>
</head>
<body class="bg-[#0b0f19] text-slate-100 min-h-screen flex">

  <aside class="w-80 bg-slate-900 border-r border-slate-800 p-6 flex flex-col justify-between shrink-0 h-screen overflow-y-auto custom-scrollbar">
    <div class="space-y-6">
      <div class="flex items-center gap-2">
        <span class="text-2xl">📊</span>
        <div>
          <h2 class="font-black text-sm uppercase tracking-widest text-slate-400 leading-none">Creator Panel</h2>
          <h1 class="font-black text-lg text-white mt-1">Reddit Slide Generator</h1>
        </div>
      </div>

      <hr class="border-slate-800" />

      <div class="space-y-4">
        <div>
          <label class="block text-xs font-black uppercase text-slate-400 tracking-wider mb-1.5">Season Title</label>
          <input 
            type="text" 
            id="input-season-date" 
            value="June 15, 2026 - Season End"
            class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-bold focus:outline-none focus:border-blue-500" 
          />
        </div>

        <div>
          <label class="block text-xs font-black uppercase text-slate-400 tracking-wider mb-1.5">Theme Preset</label>
          <select 
            id="select-theme"
            class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-bold focus:outline-none focus:border-blue-500 cursor-pointer"
          >
            <option value="clash">Clash Parchment (Matches Website)</option>
            <option value="dark">Midnight Dark (Deep Slate)</option>
            <option value="purple">Royal Purple</option>
            <option value="green">Forest Green</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-black uppercase text-slate-400 tracking-wider mb-1.5">Preview Scale</label>
          <input 
            type="range" 
            id="range-scale" 
            min="0.3" 
            max="0.8" 
            step="0.05" 
            value="0.5" 
            class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer"
          />
          <div class="flex justify-between text-[10px] text-slate-500 font-bold mt-1">
            <span>Smaller (30%)</span>
            <span id="scale-label">50%</span>
            <span>Larger (80%)</span>
          </div>
        </div>
      </div>

      <hr class="border-slate-800" />

      <div class="space-y-2">
        <label class="block text-xs font-black uppercase text-slate-400 tracking-wider mb-2">Select Slide</label>
        <div class="grid grid-cols-1 gap-2" id="slide-tabs">
          <button data-slide="1" class="active flex items-center justify-between text-left text-xs font-black uppercase py-2.5 px-3 rounded-lg bg-blue-600 text-white transition-all shadow-sm">
            <span>Slide 1: Heroes & Cast</span>
            <span class="opacity-50">#1</span>
          </button>
          <button data-slide="2" class="flex items-center justify-between text-left text-xs font-black uppercase py-2.5 px-3 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-all">
            <span>Slide 2: Top Army Types</span>
            <span class="opacity-50">#2</span>
          </button>
          <button data-slide="3" class="flex items-center justify-between text-left text-xs font-black uppercase py-2.5 px-3 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-all">
            <span>Slide 3: Leaderboard 1-10</span>
            <span class="opacity-50">#3</span>
          </button>
        </div>
      </div>
    </div>

    <div class="mt-6 space-y-3 pt-6 border-t border-slate-800">
      <button 
        id="btn-export"
        class="w-full bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-black text-sm uppercase py-3 px-4 rounded-xl shadow-lg transform active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>📥 Download Slide PNG</span>
      </button>
      <button 
        id="btn-export-all"
        class="w-full bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-black text-sm uppercase py-3 px-4 rounded-xl shadow-lg transform active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>🗂️ Download All Slides</span>
      </button>
      <div class="text-[10px] text-slate-500 text-center font-bold">
        Exports at 2x scale for crystal-clear Reddit display (4:5 Portrait)
      </div>
    </div>
  </aside>

  <main class="flex-1 bg-slate-950 flex items-center justify-center p-8 overflow-auto relative h-screen">
    <div id="canvas-scaler-wrapper" class="origin-top-left transition-transform duration-300">
      <div id="slide-canvas" class="theme-clash show-1">
        
        <header class="slide-header p-6 flex justify-between items-center shrink-0">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 bg-white/20 rounded-xl flex items-center justify-center text-3xl shadow-inner border border-white/20">🛡️</div>
            <div>
              <h1 class="text-3xl font-black uppercase tracking-tight leading-none text-white drop-shadow">LEGEND META RECAP</h1>
              <div class="text-white/80 font-black text-xs uppercase tracking-widest mt-1" id="slide-subtitle-display">June 15, 2026 - Season End</div>
            </div>
          </div>
          <div class="bg-black/20 text-white px-4 py-2 rounded-xl text-right border border-white/10 shadow-inner">
            <div class="text-lg font-black leading-none text-yellow-300">{playersAnalyzed}</div>
            <div class="text-[8px] font-bold uppercase tracking-wider mt-0.5 opacity-80">Players Analyzed</div>
          </div>
        </header>

        <div class="flex-1 overflow-hidden relative" style="height: 100%;">
          
          <!-- Slide 1: Combined Primary & Supporting Heroes (4x2 cards grid) -->
          <div id="slide-content-1" class="slide-content-block">
            <div class="grid grid-cols-4 grid-rows-2 gap-4 flex-1 h-full items-stretch">
              
              <!-- 4 Primary Heroes -->
              {primaryHeroesData.map((hero: any) => (
                <div class="card flex flex-col overflow-hidden h-full">
                  <div class={hero.heroColor + " text-white p-2.5 flex items-center gap-2.5 shrink-0"}>
                    <img 
                      src={hero.heroIcon} 
                      alt={hero.name} 
                      class={`w-11 h-11 object-cover rounded-full border border-white/20 shadow-md ${hero.name === 'Grand Warden' ? 'object-top' : ''}`} 
                    />
                    <div class="text-left min-w-0">
                      <h2 class="font-black text-xs uppercase leading-tight tracking-tight truncate">{hero.name}</h2>
                      <span class="text-[9px] font-bold uppercase tracking-wider opacity-90 block mt-0.5">Usage: {hero.usage.toFixed(1)}%</span>
                    </div>
                  </div>
                  
                  <div class="card-body-container p-3 flex-1 flex flex-col justify-between text-[11px] space-y-1.5">
                    <div>
                      <h3 class="section-title text-[9px] uppercase font-black opacity-60 tracking-wider mb-1">Top Equipments</h3>
                      <div class="list-item-gap space-y-1.5">
                        {hero.equipments.map((eq: any) => (
                          <div class="space-y-0.5">
                            <div class="list-item-text flex items-center justify-between font-bold text-[11px]">
                              <div class="flex items-center gap-1 truncate">
                                <img src={eq.icon} class="list-item-icon w-6 h-6 object-contain" />
                                <span class="truncate">{eq.name}</span>
                              </div>
                              <span>{eq.usage.toFixed(1)}%</span>
                            </div>
                            <div class="w-full h-1.5 progress-track rounded-full overflow-hidden">
                              <div class="h-full progress-fill rounded-full" style={"width: " + eq.usage + "%"}></div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div>
                      <h3 class="section-title text-[9px] uppercase font-black opacity-60 tracking-wider mb-1">Top Combos</h3>
                      <div class="list-item-gap space-y-1.5">
                        {hero.combos.map((c: any) => (
                          <div class="space-y-0.5">
                            <div class="list-item-text flex items-center justify-between font-bold text-[11px]">
                              <div class="flex items-center gap-0.5">
                                {c.eqParts.map((part: any) => (
                                  <img src={part.icon} class="list-item-icon w-6 h-6 object-contain" title={part.name} />
                                ))}
                              </div>
                              <span>{c.usage.toFixed(1)}%</span>
                            </div>
                            <div class="w-full h-1.5 progress-track rounded-full overflow-hidden">
                              <div class="h-full progress-fill-orange rounded-full" style={"width: " + c.usage + "%"}></div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div>
                      <h3 class="section-title text-[9px] uppercase font-black opacity-60 tracking-wider mb-1">Top Pets</h3>
                      <div class="list-item-gap space-y-1.5">
                        {hero.pets.map((p: any) => (
                          <div class="space-y-0.5">
                            <div class="list-item-text flex items-center justify-between font-bold text-[11px]">
                              <div class="flex items-center gap-1 truncate">
                                <img src={p.icon} class="list-item-icon w-6 h-6 object-contain" />
                                <span class="truncate">{p.name}</span>
                              </div>
                              <span>{p.usage.toFixed(1)}%</span>
                            </div>
                            <div class="w-full h-1.5 progress-track rounded-full overflow-hidden">
                              <div class="h-full progress-fill-green rounded-full" style={"width: " + p.usage + "%"}></div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              ))}

