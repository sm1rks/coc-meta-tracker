---
import Layout from '../layouts/Layout.astro';
import ArmyTypesCard from '../components/ArmyTypesCard.astro';
import { getMetaData } from '../utils/dataUtils';

const metaData = getMetaData();

const armies = metaData?.armies || [];

let lastUpdated = '';
if (metaData?.lastUpdated) {
  lastUpdated = metaData.lastUpdated;
}
---

<Layout 
  title="Top Armies - Clash Tracker" 
  playersAnalyzed={metaData?.playersAnalyzed || 0}
  attacksAnalyzed={metaData?.attacksAnalyzed || 0}
  lastUpdated={lastUpdated}
>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="lg:col-span-4">
      {armies.length > 0 && <ArmyTypesCard armies={armies} noScroll={true} />}
    </div>
  </div>
</Layout>
