---
import fs from 'fs';
import path from 'path';
import HeroCard from '../components/HeroCard.astro';
import SuperTroopsCard from '../components/SuperTroopsCard.astro';
import TopPlayersCard from '../components/TopPlayersCard.astro';
import '../styles/global.css';

// Read data during SSR
const dataPath = path.join(process.cwd(), 'data', 'meta.json');
let metaData = null;

try {
  if (fs.existsSync(dataPath)) {
    metaData = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
  }
} catch (e) {
  console.error("Error reading meta data:", e);
}

// Ensure defaults if data is missing
const heroes = metaData?.heroes || [];
const equipments = metaData?.equipments || [];
const superTroops = metaData?.superTroops || [];
const combos = metaData?.combos || [];
const playersAnalyzed = metaData?.playersAnalyzed || 0;

let lastUpdated = 'Unknown';
if (metaData?.lastUpdated) {
  const d = new Date(metaData.lastUpdated);
  lastUpdated = `${d.toLocaleDateString()} ${d.toLocaleTimeString()}`;
}

// Group equipments by hero
const getHeroEquipments = (heroName: string) => {
  return equipments
    .filter((eq: any) => eq.hero === heroName)
    .sort((a: any, b: any) => b.usage - a.usage);
};

// Group combos by hero
const getHeroCombos = (heroName: string) => {
  return combos
    .filter((c: any) => c.hero === heroName)
    .sort((a: any, b: any) => b.usage - a.usage);
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Clash Meta Tracker - Legends</title>
  </head>
  <body class="min-h-screen bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] relative">
    <!-- Vibrant decorative background -->
    <div class="fixed inset-0 bg-gradient-to-br from-coc-blue/20 to-coc-gold/10 -z-10"></div>
    
    <header class="bg-gradient-to-b from-coc-dark to-slate-800 border-b-8 border-coc-gold shadow-2xl p-6 mb-8 relative overflow-hidden">
      <div class="absolute -right-20 -top-20 w-64 h-64 bg-coc-gold rounded-full mix-blend-overlay opacity-20 blur-3xl"></div>
      <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-coc-blue rounded-full mix-blend-overlay opacity-20 blur-3xl"></div>
      
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 relative z-10">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 bg-gradient-to-tr from-coc-gold to-yellow-300 rounded-2xl shadow-inner border-4 border-white/20 flex items-center justify-center transform -rotate-6 transition-transform hover:rotate-0">
            <span class="text-4xl">🛡️</span>
          </div>
          <div>
            <h1 class="text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-coc-gold to-yellow-200 drop-shadow-sm tracking-tight m-0">
              META TRACKER
            </h1>
            <div class="text-coc-panel/80 font-bold tracking-widest text-sm mt-1 uppercase">Legend League • Season Top 200</div>
          </div>
        </div>
        
        <div class="bg-black/40 backdrop-blur-md px-8 py-4 rounded-3xl border border-white/10 text-center shadow-inner">
          <div class="text-coc-gold font-black text-4xl leading-none">{playersAnalyzed}</div>
          <div class="text-white/70 text-xs font-bold uppercase tracking-widest mt-1">Players Analyzed</div>
          <div class="text-white/40 text-[10px] mt-2 font-mono" id="lastUpdated" data-timestamp={metaData?.lastUpdated || ''}>Updated: {lastUpdated}</div>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 pb-16">
      {!metaData && (
        <div class="bg-red-500/10 border-l-4 border-red-500 p-6 mb-8 rounded-xl backdrop-blur-sm shadow-md">
          <p class="text-red-700 font-bold text-lg">No meta data found. Please run <code class="bg-red-500/20 px-2 py-1 rounded">npm run fetch-data</code> to generate it.</p>
        </div>
      )}

      <div class="mb-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {heroes.map((hero: any) => (
            <HeroCard 
              name={hero.name} 
              avgLevel={hero.avgLevel} 
              equipments={getHeroEquipments(hero.name)} 
              combos={getHeroCombos(hero.name)}
            />
          ))}
          {superTroops.length > 0 && (
            <SuperTroopsCard troops={superTroops} />
          )}
          {metaData.topPlayers && metaData.topPlayers.length > 0 && (
            <TopPlayersCard players={metaData.topPlayers} />
          )}
        </div>
      </div>
    </main>
    <script>
      const updatedEl = document.getElementById('lastUpdated');
      const timestamp = updatedEl?.getAttribute('data-timestamp');
      if (timestamp) {
        const d = new Date(timestamp);
        updatedEl.textContent = `Updated: ${d.toLocaleDateString()} ${d.toLocaleTimeString()}`;
      }
    </script>
  </body>
</html>
