---
import Layout from '../layouts/Layout.astro';
import HeroCard from '../components/HeroCard.astro';
import SuperTroopsCard from '../components/SuperTroopsCard.astro';
import SiegeMachinesCard from '../components/SiegeMachinesCard.astro';
import { getMetaData } from '../utils/dataUtils';

const metaData = getMetaData();

const heroes = [...(metaData?.heroes || [])].sort((a: any, b: any) => b.usage - a.usage);
const equipments = metaData?.equipments || [];
const combos = metaData?.combos || [];
const pets = metaData?.pets || [];

const getHeroEquipments = (heroName: string) => equipments.filter((eq: any) => eq.hero === heroName).sort((a: any, b: any) => b.usage - a.usage);
const getHeroCombos = (heroName: string) => combos.filter((c: any) => c.hero === heroName).sort((a: any, b: any) => b.usage - a.usage);
const getHeroPets = (heroName: string) => pets.filter((p: any) => p.hero === heroName).sort((a: any, b: any) => b.usage - a.usage);

const superTroops = metaData?.superTroops || [];
const siegeMachines = metaData?.siegeMachines || [];

let lastUpdated = '';
if (metaData?.lastUpdated) {
  lastUpdated = metaData.lastUpdated;
}
---

<Layout 
  title="Stats Meta - Clash Tracker" 
  playersAnalyzed={metaData?.playersAnalyzed || 0}
  attacksAnalyzed={metaData?.attacksAnalyzed || 0}
  lastUpdated={lastUpdated}
>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {heroes.map((hero: any) => (
      <HeroCard 
        name={hero.name} 
        usage={hero.usage} 
        equipments={getHeroEquipments(hero.name)} 
        combos={getHeroCombos(hero.name)}
        pets={getHeroPets(hero.name)}
      />
    ))}
    
    {superTroops.length > 0 && <SuperTroopsCard troops={superTroops} />}
    
    {siegeMachines.length > 0 && <SiegeMachinesCard machines={siegeMachines} />}
  </div>
</Layout>
