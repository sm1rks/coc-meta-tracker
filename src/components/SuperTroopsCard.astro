---
interface Props {
  troops: { name: string; usage: number }[];
}

const { troops } = Astro.props;

const getSuperTroopIcon = (name: string) => `icons/Icon_HV_${name.replace(/\s+/g, '_')}.png`;
---
<div class="bg-white/90 backdrop-blur-md rounded-2xl shadow-xl border-4 border-coc-gold/30 flex flex-col h-full">
  <div class="bg-gradient-to-r from-red-500 to-orange-600 p-3 rounded-t-xl border-b-4 border-black/10 flex items-center gap-3">
    <img src="icons/Icon_HV_Super_Troops.png" alt="Super Troops" class="w-12 h-12 object-contain drop-shadow-lg shrink-0" onerror="this.style.display='none'" />
    <div class="min-w-0">
      <h2 class="text-lg xl:text-xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">Super Troops</h2>
    </div>
  </div>
  
  <div class="p-0 flex-1 relative min-h-[300px]">
    <div class="absolute inset-0 overflow-y-auto px-4 py-4 space-y-2 custom-scrollbar">
      {troops.map(troop => (
        <div class="flex items-center justify-between group/row relative gap-3">
          <div class="flex items-center gap-3">
            <div class="relative w-8 h-8 flex-shrink-0 cursor-help group/icon">
              <div class="w-full h-full rounded-lg overflow-hidden border-2 border-coc-gold/40 shadow-sm bg-gradient-to-b from-gray-100 to-gray-200 transition-transform group-hover/icon:scale-105">
                <img src={getSuperTroopIcon(troop.name)} alt={troop.name} class="w-full h-full object-cover transform scale-110" onerror="this.style.display='none'" />
              </div>
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-black/80 text-white text-xs font-bold rounded opacity-0 group-hover/icon:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-10 shadow-lg">
                {troop.name}
              </div>
            </div>
          </div>
          <div class="flex items-center gap-1 sm:gap-2 flex-grow justify-end min-w-0">
            <div class="flex-1 h-3 bg-gray-200 rounded-full overflow-hidden shadow-inner min-w-[40px]">
              <div 
                class="h-full bg-gradient-to-r from-red-500 to-orange-500 rounded-full transition-all duration-1000 shadow-sm"
                style={`width: ${troop.usage}%`}
              ></div>
            </div>
            <div class="text-xs sm:text-sm font-bold text-red-600 w-8 sm:w-10 text-right flex-shrink-0">{troop.usage}%</div>
          </div>
        </div>
      ))}
      {troops.length === 0 && <div class="text-gray-400 text-sm italic">No active super troops found.</div>}
    </div>
  </div>
</div>
