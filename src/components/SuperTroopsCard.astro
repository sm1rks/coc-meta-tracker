---
interface Props {
  troops: { name: string; usage: number }[];
}

const { troops } = Astro.props;
---
<div class="bg-white/90 backdrop-blur-md rounded-2xl shadow-xl border-4 border-coc-gold/30 flex flex-col h-full">
  <div class="bg-gradient-to-r from-red-500 to-orange-600 p-3 rounded-t-xl border-b-4 border-black/10 flex items-center gap-3">
    <img src="/icons/Icon_HV_Super_Troops.png" alt="Super Troops" class="w-12 h-12 object-contain drop-shadow-lg shrink-0" onerror="this.style.display='none'" />
    <div class="min-w-0">
      <h2 class="text-lg xl:text-xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">Super Troops</h2>
    </div>
  </div>
  
  <div class="p-3 xl:p-4 flex-1">
    <div class="space-y-3 xl:space-y-4">
      {troops.map(troop => (
        <div class="grid grid-cols-[110px_1fr_40px] xl:grid-cols-[115px_1fr_40px] items-center gap-1 xl:gap-2 group">
          <div class="font-bold text-[11px] xl:text-xs text-gray-800 leading-tight">
             {troop.name}
          </div>
          <div class="w-full h-2.5 bg-gray-200 rounded-full overflow-hidden shadow-inner">
            <div 
              class="h-full bg-gradient-to-r from-yellow-400 to-coc-red rounded-full"
              style={`width: ${troop.usage}%`}
            ></div>
          </div>
          <div class="text-[11px] xl:text-xs font-bold text-coc-darkblue text-right">
            {troop.usage.toFixed(1)}%
          </div>
        </div>
      ))}
      {troops.length === 0 && <div class="text-gray-400 text-sm italic">No active super troops found.</div>}
    </div>
  </div>
</div>
