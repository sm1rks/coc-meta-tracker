---
interface Props {
  troops: { name: string; usage: number }[];
}

const { troops } = Astro.props;

const activeTroops = troops.filter(t => t.usage > 0);
const displayedTroops = activeTroops.length > 0 ? activeTroops : troops;

import { getSuperTroopIcon, basePath, placeholderIcon } from '../utils/iconUtils';
---
<div class="bg-[#603813] rounded-2xl shadow-xl border-4 border-[#603813] overflow-hidden transform transition-transform duration-200 hover:scale-[1.01] [will-change:transform] [backface-visibility:hidden] flex flex-col h-full relative z-0 hover:z-10">
  <div class="bg-gradient-to-r from-red-500 to-orange-600 p-3 border-b-4 border-black/15 flex items-center gap-3 shrink-0">
    <img src={`${basePath}icons/Icon_HV_Super_Troops.webp`} alt="Super Troops" loading="lazy" decoding="async" class="w-12 h-12 object-contain drop-shadow-lg shrink-0" onerror="this.style.display='none'" />
    <div class="min-w-0">
      <h2 class="text-lg xl:text-xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">Super Troops</h2>
    </div>
  </div>
  
  <div class="bg-[#f4e4c1] px-4 py-4 flex-1 flex flex-col justify-center">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5">
      {displayedTroops.map(troop => (
        <div class="flex items-center justify-between group/row relative gap-2.5">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 flex-shrink-0 cursor-help rounded-lg overflow-hidden border border-[#c4a481] shadow-sm bg-white/60" data-tooltip={troop.name}>
              <img src={getSuperTroopIcon(troop.name)} alt={troop.name} loading="lazy" decoding="async" class="w-full h-full object-cover transform scale-110" onerror={`this.onerror=null;this.src='${placeholderIcon}';`} />
            </div>
          </div>
          <div class="flex items-center gap-2 flex-grow justify-end min-w-0">
            <div class="flex-1 h-3 bg-[#603813]/12 rounded-full overflow-hidden shadow-inner border border-[#603813]/15 min-w-[40px]">
              <div 
                class="h-full bg-gradient-to-r from-red-500 to-orange-500 rounded-full transition-all duration-1000 shadow-sm"
                style={`width: ${troop.usage}%`}
              ></div>
            </div>
            <div class="text-xs sm:text-sm font-black text-red-700 w-11 text-right flex-shrink-0 tabular-nums">{troop.usage.toFixed(1)}%</div>
          </div>
        </div>
      ))}
      {displayedTroops.length === 0 && <div class="text-[#603813]/50 text-sm italic col-span-full">No active super troops found.</div>}
    </div>
  </div>
</div>
