---
import type { ClanCastleComboStat, UsageStat } from '../types';
import { getTroopIcon, getSpellIcon, basePath } from '../utils/iconUtils';
import TrendBadge from './TrendBadge.astro';

interface Props {
  combos: ClanCastleComboStat[];
  ccSpells?: UsageStat[];
}

const { combos = [], ccSpells = [] } = Astro.props;
const topCombos = combos.slice(0, 5);
const topSpells = ccSpells.slice(0, 4);
const clampPct = (val: number) => Math.min(100, Math.max(0, val));
---
<div class="bg-[#603813] rounded-2xl shadow-xl border-4 border-[#603813] overflow-hidden transition-transform duration-200 hover:scale-[1.01] motion-reduce:transition-none motion-reduce:hover:scale-100 flex flex-col h-full relative z-0 hover:z-10">
  <div class="bg-gradient-to-r from-emerald-600 to-teal-800 p-3 border-b-4 border-black/15 flex items-center gap-3 shrink-0">
    <img src={`${basePath}icons/Icon_HV_Clan_Castle.webp`} alt="Clan Castle" width="48" height="48" loading="lazy" decoding="async" data-hide-on-error="true" class="w-12 h-12 object-contain scale-110 drop-shadow-lg shrink-0" />
    <div class="min-w-0">
      <h2 class="text-lg xl:text-xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">Clan Castle</h2>
    </div>
  </div>
  
  <div class="bg-[#f4e4c1] px-4 py-4 flex-1 flex flex-col justify-between gap-4">
    <div class="space-y-2.5">
      <h3 class="text-xs font-black text-[#603813]/80 tracking-wider uppercase">TOP CC TROOP SETUPS</h3>
      <div class="space-y-2">
        {topCombos.map(combo => (
          <div class="flex items-center justify-between gap-2.5">
            <div class="flex items-center gap-1 bg-white/65 px-1.5 py-1 rounded-lg border border-[#c4a481] shadow-2xs shrink-0 flex-wrap max-w-[180px]">
              {combo.units.map(u => (
                <div class="flex items-center gap-0.5 cursor-help" data-tooltip={`${u.count}× ${u.name}`}>
                  <img src={getTroopIcon(u.name)} alt={u.name} width="22" height="22" loading="lazy" decoding="async" class="w-5.5 h-5.5 object-contain rounded" />
                  <span class="text-[10px] font-black text-[#4a2e0f] tabular-nums">x{u.count}</span>
                </div>
              ))}
            </div>
            <div class="flex items-center gap-2 flex-grow justify-end min-w-0">
              <div class="flex-1 h-2.5 bg-[#603813]/12 rounded-full overflow-hidden shadow-inner border border-[#603813]/15 min-w-[30px]">
                <div 
                  class="h-full bg-gradient-to-r from-emerald-500 to-teal-600 rounded-full shadow-sm"
                  style={`width: ${combo.usage > 0 ? Math.max(2, clampPct(combo.usage)) : 0}%`}
                ></div>
              </div>
              <div class="flex flex-col items-end w-13 shrink-0 leading-tight">
                <span class="text-xs font-black text-emerald-900 tabular-nums">{combo.usage.toFixed(1)}%</span>
                <div class="flex items-center gap-1">
                  {combo.threeStarRate !== undefined && (
                    <span class="text-[9px] font-black text-amber-800 tabular-nums cursor-help" data-tooltip={`${combo.threeStarCount ?? 0}/${combo.count} 3-Star Attacks`}>
                      ★{combo.threeStarRate.toFixed(0)}%
                    </span>
                  )}
                  <TrendBadge delta={combo.usageDelta} />
                </div>
              </div>
            </div>
          </div>
        ))}
        {topCombos.length === 0 && <div class="text-[#603813]/65 text-sm italic">No Clan Castle troop data found.</div>}
      </div>
    </div>

    {topSpells.length > 0 && (
      <div class="pt-3 border-t-2 border-[#603813]/15 space-y-2">
        <h3 class="text-xs font-black text-[#603813]/80 tracking-wider uppercase">TOP CC SPELLS</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-2">
          {topSpells.map(sp => (
            <div class="flex items-center justify-between gap-2">
              <div class="w-7 h-7 flex-shrink-0 cursor-help rounded-lg overflow-hidden border border-[#c4a481] shadow-2xs bg-white/70" data-tooltip={sp.name}>
                <img src={getSpellIcon(sp.name)} alt={sp.name} width="28" height="28" loading="lazy" decoding="async" class="unit-img" />
              </div>
              <div class="flex items-center gap-1.5 flex-grow justify-end min-w-0">
                <div class="flex-1 h-2.5 bg-[#603813]/12 rounded-full overflow-hidden shadow-inner border border-[#603813]/15 min-w-[30px]">
                  <div 
                    class="h-full bg-gradient-to-r from-teal-500 to-emerald-600 rounded-full"
                    style={`width: ${sp.usage > 0 ? Math.max(2, clampPct(sp.usage)) : 0}%`}
                  ></div>
                </div>
                <div class="flex flex-col items-end w-12 shrink-0 leading-tight">
                  <span class="text-xs font-black text-teal-900 tabular-nums">{sp.usage.toFixed(1)}%</span>
                  <div class="flex items-center gap-1">
                    {sp.threeStarRate !== undefined && (
                      <span class="text-[9px] font-black text-amber-800 tabular-nums cursor-help" data-tooltip={`${sp.threeStarRate.toFixed(1)}% 3-Star Rate`}>
                        ★{sp.threeStarRate.toFixed(0)}%
                      </span>
                    )}
                    <TrendBadge delta={sp.usageDelta} />
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</div>
