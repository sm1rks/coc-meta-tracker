
---
import type { ArmyData, PlayerData } from '../types';

interface Props {
  title?: string;
  noScroll?: boolean;
  armies: ArmyData[];
  players?: PlayerData[];
}

const { armies, title = "Top Army Types", noScroll = false, players = [] } = Astro.props;

import PlayerRow from './PlayerRow.astro';
import { getHeroIcon, getEqIcon, getPetIcon, getSuperTroopIcon, getSiegeMachineIcon, getTroopIcon, getSpellIcon } from '../utils/iconUtils';

---
<div class="bg-[#f4e4c1] rounded-2xl shadow-xl border-4 border-[#603813] flex flex-col h-full overflow-hidden lg:col-span-4">
  <div class="bg-gradient-to-r from-red-600 to-orange-600 p-3 rounded-t-xl border-b-4 border-black/10 flex items-center gap-3 shrink-0">
    <div class="bg-black/20 text-white rounded-lg p-2 shadow-inner inline-block transform -rotate-3 text-2xl leading-none w-12 h-12 flex items-center justify-center">⚔️</div>
    <div class="min-w-0">
      <h2 class="text-lg xl:text-xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">{title}</h2>
    </div>
  </div>
  
  <div class={`p-0 flex-1 ${noScroll ? 'min-h-[fit-content]' : 'min-h-[300px]'}`}>
    <div class={`${noScroll ? 'relative h-auto p-4' : 'absolute inset-0 overflow-y-auto p-4'} space-y-4 custom-scrollbar`}>
      {armies.map((army, idx) => {
        const armyPlayers = players.filter(p => p.armyType === army.name);
        return (
        <details class="group/details bg-white/40 rounded-lg border border-[#c4a481] [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex flex-col group/row relative gap-2 p-3 cursor-pointer list-none hover:bg-white/60 transition-colors rounded-lg">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-3">
              <div class="flex items-center gap-2 sm:gap-3">
                <div class="w-6 h-6 flex items-center justify-center font-black text-[#603813] opacity-50 shrink-0">#{idx + 1}</div>
                <div class="min-w-0">
                  <div class="font-black text-[#4a2e0f] text-base sm:text-xl leading-tight uppercase tracking-wide drop-shadow-sm truncate">
                    {army.name}
                  </div>
                  {army.count !== undefined && army.playerCount !== undefined && army.battlesCount !== undefined && (
                    <div class="text-[#603813]/70 text-[10px] sm:text-xs font-bold uppercase tracking-widest mt-0.5">
                      {army.battlesCount} Battles • {army.playerCount} Players
                    </div>
                  )}
                </div>
              </div>
              <div class="flex items-center gap-2 w-full sm:w-auto sm:flex-grow sm:justify-end min-w-0 sm:max-w-[200px] pl-8 sm:pl-0">
                <div class="flex-1 h-3 sm:h-4 bg-[#603813]/10 rounded-full overflow-hidden shadow-inner min-w-[40px] border border-[#603813]/20">
                  <div 
                    class="h-full bg-gradient-to-r from-red-600 to-amber-500 rounded-full transition-all duration-1000 shadow-sm"
                    style={`width: ${army.usage}%`}
                  ></div>
                </div>
                <div class="text-xs sm:text-sm font-black text-[#603813] w-10 sm:w-14 text-right flex-shrink-0">{army.usage.toFixed(1)}%</div>
                
                <!-- Expansion Arrow -->
                <div class="w-6 h-6 flex items-center justify-center text-[#603813]/50 group-open/details:rotate-180 transition-transform duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </div>
              </div>
            </div>

            {(army.topHeroes && army.topHeroes.length > 0 || army.topSuperTroops && army.topSuperTroops.length > 0) && (
              <div class="mt-2 pt-3 border-t-2 border-[#c4a481]/30 flex flex-wrap gap-4 items-center">
                {army.topHeroes && army.topHeroes.map(hero => {
                   const eqList = hero.equipment ? hero.equipment.split(' + ') : [];
                   return (
                     <div class="flex items-center gap-1.5 bg-black/5 rounded-xl p-2 border border-[#603813]/10 shadow-sm">
                       <div class="cursor-help overflow-hidden" data-tooltip={hero.name}>
                         <img src={getHeroIcon(hero.name)} alt={hero.name} loading="lazy" decoding="async" class="w-10 h-10 object-contain drop-shadow-md" onerror="this.style.display='none'"/>
                       </div>
                       
                       {hero.pet && (
                         <div class="cursor-help ml-1 overflow-hidden" data-tooltip={hero.pet}>
                           <img src={getPetIcon(hero.pet)} alt={hero.pet} loading="lazy" decoding="async" class="w-8 h-8 object-contain drop-shadow-md border border-[#603813]/10 rounded-lg bg-black/5" onerror="this.style.display='none'"/>
                         </div>
                       )}

                       {eqList.length > 0 && (
                         <div class="flex items-center ml-1 gap-1">
                           {eqList.map(eq => (
                             <div class="cursor-help overflow-hidden" data-tooltip={eq}>
                               <img src={getEqIcon(eq)} alt={eq} loading="lazy" decoding="async" class="w-8 h-8 object-contain drop-shadow-md border border-[#603813]/10 rounded-lg bg-black/5" onerror="this.style.display='none'"/>
                             </div>
                           ))}
                         </div>
                       )}
                     </div>
                   );
                })}

                {army.topSiegeMachine && (
                  <div class="flex items-center gap-2 bg-black/5 rounded-xl p-2 border border-[#603813]/10 shadow-sm">
                    <div class="cursor-help overflow-hidden" data-tooltip={army.topSiegeMachine}>
                      <img src={getSiegeMachineIcon(army.topSiegeMachine)} alt={army.topSiegeMachine} loading="lazy" decoding="async" class="w-10 h-10 object-contain drop-shadow-md" onerror="this.style.display='none'"/>
                    </div>
                  </div>
                )}
              </div>
            )}
            {((army.troops && army.troops.length > 0) || (army.spells && army.spells.length > 0) || (army.ccTroops && army.ccTroops.length > 0) || (army.ccSpells && army.ccSpells.length > 0)) && (
              <div class="flex flex-wrap items-end gap-x-4 gap-y-2 mt-2 border-t-2 border-[#c4a481]/30 pt-2">
                {((army.troops && army.troops.length > 0) || (army.spells && army.spells.length > 0)) && (
                  <div class="flex items-center gap-1 flex-wrap">
                    {army.troops && army.troops.map(t => (
                      <div class="flex flex-col items-center shrink-0">
                        <div class="w-7 h-7 rounded border border-[#603813]/20 shadow-sm bg-white overflow-hidden cursor-help shrink-0" data-tooltip={t.name}>
                          <img src={getTroopIcon(t.name)} alt={t.name} loading="lazy" decoding="async" class="w-full h-full object-cover scale-110" onerror="this.style.display='none'" />
                        </div>
                        <span class="text-[10px] font-black text-[#603813]/70 mt-0.5">x{t.count}</span>
                      </div>
                    ))}
                    {army.spells && army.spells.map(s => (
                      <div class="flex flex-col items-center shrink-0">
                        <div class="w-7 h-7 rounded border border-[#603813]/20 shadow-sm bg-white overflow-hidden cursor-help shrink-0" data-tooltip={s.name}>
                          <img src={getSpellIcon(s.name)} alt={s.name} loading="lazy" decoding="async" class="w-full h-full object-cover scale-110" onerror="this.style.display='none'" />
                        </div>
                        <span class="text-[10px] font-black text-[#603813]/70 mt-0.5">x{s.count}</span>
                      </div>
                    ))}
                  </div>
                )}

                {((army.ccTroops && army.ccTroops.length > 0) || (army.ccSpells && army.ccSpells.length > 0)) && (
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-[10px] font-black text-orange-700 bg-orange-100 border border-orange-200 rounded px-1 py-0.5 select-none shrink-0 self-center">CC</span>
                    {army.ccTroops && army.ccTroops.map(t => (
                      <div class="flex flex-col items-center shrink-0">
                        <div class="w-7 h-7 rounded border border-[#603813]/20 shadow-sm bg-white/40 overflow-hidden cursor-help shrink-0" data-tooltip={`${t.name} (CC)`}>
                          <img src={getTroopIcon(t.name)} alt={t.name} loading="lazy" decoding="async" class="w-full h-full object-cover scale-110" onerror="this.style.display='none'" />
                        </div>
                        <span class="text-[10px] font-black text-[#603813]/60 mt-0.5">x{t.count}</span>
                      </div>
                    ))}
                    {army.ccSpells && army.ccSpells.map(s => (
                      <div class="flex flex-col items-center shrink-0">
                        <div class="w-7 h-7 rounded border border-[#603813]/20 shadow-sm bg-white/40 overflow-hidden cursor-help shrink-0" data-tooltip={`${s.name} (CC)`}>
                          <img src={getSpellIcon(s.name)} alt={s.name} loading="lazy" decoding="async" class="w-full h-full object-cover scale-110" onerror="this.style.display='none'" />
                        </div>
                        <span class="text-[10px] font-black text-[#603813]/60 mt-0.5">x{s.count}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}
          </summary>

          {armyPlayers.length > 0 && (
            <div class="p-3 border-t-2 border-[#c4a481]/30 bg-white/50 rounded-b-lg space-y-2 cursor-default">
              <div class="flex items-center text-[10px] font-black text-[#603813]/60 uppercase tracking-widest px-3 pb-1 border-b-2 border-[#603813]/10 mb-2 hidden md:flex">
                <div class="w-12 text-center shrink-0 mr-4">Rank</div>
                <div class="w-1/4 min-w-[200px]">Player / Trophies</div>
                <div class="flex-1">Army Setup</div>
              </div>
              
              {armyPlayers.map(player => (
                <PlayerRow player={player} theme="brown" />
              ))}
            </div>
          )}
        </details>
        );
      })}
      {armies.length === 0 && <div class="text-[#603813]/60 text-sm italic text-center py-4 font-bold">No army data found.</div>}
    </div>
  </div>
</div>
