---
import type { ArmyData, PlayerData } from '../types';
import PlayerRow from './PlayerRow.astro';
import ArmyComposition from './ArmyComposition.astro';
import { getEqIcon, getTroopIcon, basePath } from '../utils/iconUtils';
import { getCoreArmyName } from '../utils/dataUtils';

interface Props {
  title?: string;
  noScroll?: boolean;
  armies: ArmyData[];
  players?: PlayerData[];
}

const { armies, title = "Top Army Types", noScroll = false, players = [] } = Astro.props;

// Group armies by core name
const groupsMap = new Map<string, {
  coreName: string;
  totalCount: number;
  totalBattlesCount: number;
  totalPlayerCount: number;
  totalUsage: number;
  variants: ArmyData[];
}>();

for (const army of armies) {
  const coreName = getCoreArmyName(army.name);
  if (!groupsMap.has(coreName)) {
    groupsMap.set(coreName, {
      coreName,
      totalCount: 0,
      totalBattlesCount: 0,
      totalPlayerCount: 0,
      totalUsage: 0,
      variants: []
    });
  }
  const group = groupsMap.get(coreName)!;
  group.totalCount += army.count || 0;
  group.totalBattlesCount += army.battlesCount || 0;
  group.totalPlayerCount += army.playerCount || 0;
  group.totalUsage += army.usage || 0;
  group.variants.push(army);
}

const groupedArmies = Array.from(groupsMap.values())
  .sort((a, b) => b.totalUsage - a.totalUsage);

const getGroupSignatureIcons = (coreName: string, variants: ArmyData[]): { src: string; label: string }[] => {
  if (coreName === "Fireball" || coreName === "Fireball Value") {
    return [{ src: getEqIcon("Fireball"), label: "Fireball" }];
  }
  if (coreName === "Hydra") {
    return [
      { src: getTroopIcon("Dragon"), label: "Dragon" },
      { src: getTroopIcon("Dragon Rider"), label: "Dragon Rider" }
    ];
  }
  if (coreName === "LaLo") {
    return [
      { src: getTroopIcon("Lava Hound"), label: "Lava Hound" },
      { src: getTroopIcon("Balloon"), label: "Balloon" }
    ];
  }
  if (coreName === "Hybrid") {
    return [
      { src: getTroopIcon("Miner"), label: "Miner" },
      { src: getTroopIcon("Hog Rider"), label: "Hog Rider" }
    ];
  }
  if (coreName.includes(" & ")) {
    return coreName.split(" & ").slice(0, 2).map(part => ({
      src: getTroopIcon(part.trim()),
      label: part.trim()
    }));
  }
  const primaryUnit = coreName !== "Unknown" ? coreName : (variants[0]?.troops?.[0]?.name || "Barbarian");
  return [{ src: getTroopIcon(primaryUnit), label: primaryUnit }];
};
---
<div class="bg-[#603813] rounded-2xl shadow-xl border-4 border-[#603813] flex flex-col h-full overflow-hidden col-span-full">
  <div class="bg-gradient-to-r from-red-600 to-orange-600 p-3 border-b-4 border-black/15 flex items-center gap-3 shrink-0">
    <img src={`${basePath}icons/Icon_HV_Battle.webp`} alt="Top Army Types" width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 object-contain drop-shadow-lg shrink-0" />
    <div class="min-w-0">
      <h2 class="text-lg xl:text-xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">{title}</h2>
    </div>
  </div>
  
  <div class={`relative bg-[#f4e4c1] p-0 flex-1 ${noScroll ? 'min-h-[fit-content]' : 'min-h-[300px]'}`}>
    <div class={`${noScroll ? 'relative h-auto p-2 sm:p-4' : 'absolute inset-0 overflow-y-auto p-2 sm:p-4'} space-y-2.5 sm:space-y-3 custom-scrollbar`}>
      {groupedArmies.map((group, idx) => {
        const signatureIcons = getGroupSignatureIcons(group.coreName, group.variants);
        const isSingleVariant = group.variants.length === 1;
        const barWidth = Math.min(100, Math.max(0, group.totalUsage));

        return (
        <details class="group/details bg-white/45 rounded-xl border border-[#c4a481] shadow-xs overflow-hidden [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex flex-col group/row relative gap-2 p-2.5 sm:px-4 sm:py-3 cursor-pointer list-none hover:bg-white/70 transition-colors select-none focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-[#603813]">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-4">
              <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-lg bg-[#603813]/10 border border-[#c4a481] flex items-center justify-center font-black text-xs text-[#603813] shrink-0 tabular-nums">
                  #{idx + 1}
                </div>

                <div class="flex items-center -space-x-1.5 shrink-0">
                  {signatureIcons.map(icon => (
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl border border-[#c4a481] shadow-sm bg-white overflow-hidden shrink-0 relative z-0 hover:z-10" data-tooltip={icon.label}>
                      <img src={icon.src} alt={icon.label} width="40" height="40" loading="lazy" decoding="async" class="w-full h-full object-cover scale-105" />
                    </div>
                  ))}
                </div>

                <div class="min-w-0">
                  <div class="font-black text-[#4a2e0f] text-base sm:text-xl leading-tight uppercase tracking-wide drop-shadow-2xs wrap-break-word" title={group.coreName}>
                    {group.coreName}
                  </div>
                  <div class="text-[#603813]/75 text-[10px] sm:text-xs font-bold uppercase tracking-wide sm:tracking-widest mt-0.5 tabular-nums">
                    {group.totalBattlesCount} {group.totalBattlesCount === 1 ? 'Battle' : 'Battles'} • {group.totalPlayerCount} {group.totalPlayerCount === 1 ? 'Player' : 'Players'}
                    {!isSingleVariant && ` • ${group.variants.length} Variants`}
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2.5 w-full sm:w-auto sm:flex-grow sm:justify-end min-w-0 sm:max-w-[320px] md:max-w-[380px]">
                <div class="flex-1 h-3 sm:h-3.5 bg-[#603813]/12 rounded-full overflow-hidden shadow-inner min-w-[60px] border border-[#603813]/15">
                  <div 
                    class="h-full bg-gradient-to-r from-red-600 to-amber-500 rounded-full shadow-sm"
                    style={`width: ${barWidth}%`}
                  ></div>
                </div>
                <div class="text-xs sm:text-sm font-black text-[#603813] w-12 text-right flex-shrink-0 tabular-nums">{group.totalUsage.toFixed(1)}%</div>
                
                <div class="w-6 h-6 flex items-center justify-center text-[#603813]/65 group-open/details:rotate-180 transition-transform duration-200 motion-reduce:transition-none shrink-0" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </div>
              </div>
            </div>
          </summary>

          <div class="p-2 sm:p-3 border-t border-[#c4a481]/50 bg-[#fbf6ea] space-y-2.5 sm:space-y-3 cursor-default">
            {group.variants.map((variant) => {
              const variantPlayers = players.filter(p => p.armyType === variant.name);
              const templateArmyLink = variantPlayers.find(p => p.armyLink)?.armyLink;

              return (
                <div class="bg-white/80 rounded-xl border border-[#c4a481]/80 shadow-xs overflow-hidden">
                  <div class="flex flex-col md:flex-row items-center justify-between gap-2 md:gap-4 p-2 sm:p-3">
                    <div class="flex flex-col justify-center w-full md:w-[195px] shrink-0 min-w-0">
                      <div class="flex items-center justify-between md:justify-start flex-wrap gap-1.5 mb-1">
                        <div class="flex items-center gap-1.5 min-w-0">
                          <span class="inline-flex items-center gap-1 text-xs font-black text-[#603813] bg-[#f4e4c1] px-2 py-0.5 rounded border border-[#c4a481]/80 tabular-nums shrink-0">
                            {variant.usage.toFixed(1)}%
                          </span>
                          <span class="md:hidden text-[#603813]/75 text-[10px] font-bold uppercase tracking-wide tabular-nums truncate">
                            {variant.battlesCount} {variant.battlesCount === 1 ? 'Battle' : 'Battles'} • {variant.playerCount} {variant.playerCount === 1 ? 'Player' : 'Players'}
                          </span>
                        </div>
                        {templateArmyLink && (
                          <a 
                            href={templateArmyLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            data-copy-army={templateArmyLink}
                            class="bg-amber-100 hover:bg-amber-200 active:bg-amber-300 text-[#603813] text-[10px] font-black px-2.5 py-1 md:px-2 md:py-0.5 rounded cursor-pointer border border-[#c4a481] shadow-2xs transition-colors shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#603813]"
                            title="Open & Copy Template Army Link"
                          >
                            COPY ARMY
                          </a>
                        )}
                      </div>

                      <div class="font-black text-xs sm:text-sm text-[#4a2e0f] uppercase leading-snug wrap-break-word">
                        {isSingleVariant && variant.name === group.coreName ? 'Most Common Setup' : variant.name}
                      </div>

                      <div class="hidden md:block text-[#603813]/75 text-[10px] font-bold uppercase tracking-wider mt-0.5 tabular-nums">
                        {variant.battlesCount} {variant.battlesCount === 1 ? 'Battle' : 'Battles'} • {variant.playerCount} {variant.playerCount === 1 ? 'Player' : 'Players'}
                      </div>
                    </div>

                    <ArmyComposition
                      heroes={variant.topHeroes}
                      troops={variant.troops}
                      spells={variant.spells}
                      siegeMachine={variant.topSiegeMachine}
                      ccTroops={variant.ccTroops}
                      ccSpells={variant.ccSpells}
                    />
                  </div>

                  {variantPlayers.length > 0 && (
                    <details class="group/players border-t border-[#c4a481]/50 bg-[#f4e4c1]/35 [&_summary::-webkit-details-marker]:hidden">
                      <summary class="flex items-center justify-between px-2.5 sm:px-3 py-2 cursor-pointer list-none hover:bg-[#f4e4c1]/65 transition-colors select-none focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-[#603813]">
                        <span class="text-[11px] font-black uppercase tracking-wider text-[#603813]/85 tabular-nums">
                          View {variantPlayers.length} {variantPlayers.length === 1 ? 'Player' : 'Players'} Using This Army
                        </span>
                        <div class="w-5 h-5 flex items-center justify-center text-[#603813]/65 group-open/players:rotate-180 transition-transform duration-200 motion-reduce:transition-none" aria-hidden="true">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                          </svg>
                        </div>
                      </summary>
                      <div class="p-1.5 sm:p-2 border-t border-[#c4a481]/40 bg-white/50 space-y-2 cursor-default font-sans">
                        {variantPlayers.map(player => (
                          <PlayerRow player={player} hideArmyTitle={true} />
                        ))}
                      </div>
                    </details>
                  )}
                </div>
              );
            })}
          </div>
        </details>
        );
      })}
      {groupedArmies.length === 0 && <div class="text-[#603813]/70 text-sm italic text-center py-4 font-bold">No army data found.</div>}
    </div>
  </div>
</div>
