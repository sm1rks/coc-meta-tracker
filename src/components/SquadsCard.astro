---
import { getTroopIcon, basePath } from '../utils/iconUtils';
import { formatSquadTooltip } from '../utils/squadUtils';
import TrendBadge from './TrendBadge.astro';

interface Props {
  squads: {
    name: string;
    usage: number;
    usageDelta?: number;
    threeStarCount?: number;
    threeStarRate?: number;
  }[];
}

const { squads } = Astro.props;
const activeSquads = squads.filter(s => s.usage > 0);
const displayedSquads = activeSquads.length > 0 ? activeSquads : squads;
const clampPct = (val: number) => Math.min(100, Math.max(0, val));
---
<div class="bg-[#603813] rounded-2xl shadow-xl border-4 border-[#603813] overflow-hidden transition-transform duration-200 hover:scale-[1.01] motion-reduce:transition-none motion-reduce:hover:scale-100 flex flex-col h-full relative z-0 hover:z-10">
  <div class="bg-gradient-to-r from-amber-500 to-amber-700 p-3 border-b-4 border-black/15 flex items-center gap-3 shrink-0">
    <img src={`${basePath}icons/Icon_HV_Squad_Barracks.webp`} alt="Squads" width="48" height="48" loading="lazy" decoding="async" data-hide-on-error="true" class="w-12 h-12 object-contain scale-110 drop-shadow-lg shrink-0" />
    <div class="min-w-0">
      <h2 class="text-lg xl:text-xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">Squads</h2>
    </div>
  </div>
  
  <div class="bg-[#f4e4c1] px-4 py-4 flex-1 flex flex-col justify-center">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5">
      {displayedSquads.map(squad => (
        <div class="flex items-center justify-between group/row relative gap-2">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 flex-shrink-0 cursor-help rounded-lg overflow-hidden border border-[#c4a481] shadow-sm bg-white/60" data-tooltip={formatSquadTooltip(squad.name)}>
              <img src={getTroopIcon(squad.name)} alt={squad.name} width="32" height="32" loading="lazy" decoding="async" class="unit-img" />
            </div>
          </div>
          <div class="flex items-center gap-2 flex-grow justify-end min-w-0">
            <div class="flex-1 h-3 bg-[#603813]/12 rounded-full overflow-hidden shadow-inner border border-[#603813]/15 min-w-[40px]">
              <div 
                class="h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded-full shadow-sm"
                style={`width: ${squad.usage > 0 ? Math.max(2, clampPct(squad.usage)) : 0}%`}
              ></div>
            </div>
            <div class="flex flex-col items-end w-13 shrink-0 leading-tight">
              <span class="text-xs sm:text-sm font-black text-[#9a4a06] tabular-nums">{squad.usage.toFixed(1)}%</span>
              <div class="flex items-center gap-1">
                {squad.threeStarRate !== undefined && (
                  <span class="text-[9px] font-black text-amber-800 tabular-nums cursor-help" data-tooltip={`${squad.threeStarRate.toFixed(1)}% 3-Star Rate`}>
                    ★{squad.threeStarRate.toFixed(0)}%
                  </span>
                )}
                <TrendBadge delta={squad.usageDelta} />
              </div>
            </div>
          </div>
        </div>
      ))}
      {displayedSquads.length === 0 && <div class="text-[#603813]/65 text-sm italic col-span-full">No active squads found.</div>}
    </div>
  </div>
</div>
