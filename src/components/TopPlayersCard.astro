---
interface Props {
  players: {
    rank: number;
    name: string;
    tag: string;
    trophies: number;
    clanName: string;
    clanBadge: string;
  }[];
}

const { players } = Astro.props;
---
<div class="bg-[#f4e4c1] rounded-2xl shadow-xl border-4 border-[#603813] flex flex-col h-full overflow-hidden">
  <div class="bg-gradient-to-r from-blue-500 to-indigo-600 p-3 rounded-t-xl border-b-4 border-black/10 flex items-center gap-3 shrink-0">
    <div class="bg-black/20 text-white rounded-lg p-2 shadow-inner inline-block transform -rotate-3 text-2xl leading-none w-12 h-12 flex items-center justify-center">🏆</div>
    <div class="min-w-0">
      <h2 class="text-lg xl:text-xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">Top 200 Players</h2>
    </div>
  </div>
  
  <div class="p-0 flex-1 relative min-h-[400px]">
    <div class="absolute inset-0 overflow-y-auto p-2 space-y-1.5 custom-scrollbar">
      {players.map(player => (
        <div class="flex items-center justify-between group gap-1 bg-gray-50 hover:bg-gray-100 p-1 px-1.5 rounded-md border border-gray-100 transition-colors">
          <div class="flex items-center gap-1.5 min-w-0 flex-1">
            <div class="font-black text-gray-400 w-5 text-right shrink-0 text-[10px]">#{player.rank}</div>
            {player.clanBadge ? (
              <img src={player.clanBadge} alt={player.clanName} class="w-4 h-4 object-contain drop-shadow-sm shrink-0" onerror="this.style.display='none'" />
            ) : (
              <div class="w-4 h-4 shrink-0 flex items-center justify-center bg-gray-200 rounded-full text-[8px] font-bold text-gray-500">-</div>
            )}
            <div class="truncate min-w-0 flex-1">
              <div class="font-bold text-xs text-gray-800 truncate leading-none">{player.name}</div>
              {player.clanName && <div class="text-[9px] font-bold text-gray-500 truncate leading-tight mt-0.5">{player.clanName}</div>}
            </div>
          </div>
          <div class="flex items-center gap-0.5 shrink-0 bg-yellow-100 px-1 py-0.5 rounded border border-yellow-300">
            <span class="text-[10px] font-black text-yellow-700">{player.trophies}</span>
            <span class="text-[8px]">🏆</span>
          </div>
        </div>
      ))}
      {players.length === 0 && <div class="text-gray-400 text-sm italic">No players found.</div>}
    </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }
</style>
