---
interface Props {
  name: string;
  avgLevel: number;
  equipments: { name: string; usage: number }[];
  combos?: { name: string; usage: number }[];
}

const { name, avgLevel, equipments, combos = [] } = Astro.props;

// Helper to pick a color based on hero name
const getHeroColor = (name: string) => {
  if (name.includes("Barbarian")) return "from-orange-400 to-red-500";
  if (name.includes("Archer")) return "from-green-400 to-emerald-600";
  if (name.includes("Warden")) return "from-blue-400 to-cyan-500";
  if (name.includes("Champion")) return "from-purple-400 to-indigo-500";
  return "from-yellow-400 to-orange-500";
};

const gradient = getHeroColor(name);

const getHeroIcon = (str: string) => `Icon_HV_Hero_${str.replace(/\s+/g, '')}.png`;
const getEqIcon = (str: string) => `Icon_HV_Equipment_${str.replace(/\s+/g, '')}.png`;
const heroIcon = `/icons/${getHeroIcon(name)}`;
---
<div class="bg-white/90 backdrop-blur-md rounded-2xl shadow-xl border-4 border-coc-gold/30 transform transition-transform hover:scale-[1.02] h-full flex flex-col">
  <div class={`bg-gradient-to-r ${gradient} p-3 rounded-t-xl border-b-4 border-black/10 flex items-center gap-3`}>
    <img src={heroIcon} alt={name} class="w-12 h-12 drop-shadow-lg object-contain shrink-0" onerror="this.style.display='none'" />
    <div class="min-w-0">
      <h2 class="text-lg xl:text-xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">{name}</h2>
      <div class="text-white/90 font-bold text-xs mt-0.5">Avg Level: {avgLevel.toFixed(1)}</div>
    </div>
  </div>
  
  <div class="px-4 py-4 flex-1 flex flex-col">
    <!-- Top Equipment Section -->
    <div class="space-y-2 flex-1">
      <h3 class="text-sm font-bold text-gray-500 tracking-wider mb-1">ALL EQUIPMENT</h3>
      <div class="space-y-2">
        {equipments.map(eq => {
          const eqIcon = `/icons/${getEqIcon(eq.name)}`;
          return (
            <div class="flex items-center justify-between group/row relative gap-3">
              <div class="flex items-center gap-3">
                <!-- Icon with Tooltip -->
                <div class="relative w-8 h-8 flex-shrink-0 cursor-help group/icon">
                  <img src={eqIcon} alt={eq.name} class="w-full h-full object-contain drop-shadow" onerror="this.style.display='none'" />
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-black/80 text-white text-xs font-bold rounded opacity-0 group-hover/icon:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-10 shadow-lg">
                    {eq.name}
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-1 sm:gap-2 flex-grow justify-end min-w-0">
                <div class="flex-1 h-3 bg-gray-200 rounded-full overflow-hidden shadow-inner min-w-[40px]">
                  <div 
                    class="h-full bg-coc-blue rounded-full"
                    style={`width: ${eq.usage}%`}
                  ></div>
                </div>
                <div class="text-xs sm:text-sm font-bold text-coc-darkblue w-8 sm:w-10 text-right flex-shrink-0">{eq.usage}%</div>
              </div>
            </div>
          );
        })}
      </div>
      {equipments.length === 0 && <div class="text-gray-400 text-sm italic">No data</div>}
    </div>

    <!-- Top Combos Section -->
    {combos.length > 0 && (
      <div class="space-y-2 pt-4 mt-auto border-t-2 border-gray-100 shrink-0">
        <h3 class="text-sm font-bold text-gray-500 tracking-wider">TOP COMBOS</h3>
        <div class="space-y-2">
          {combos.slice(0, 3).map(combo => {
            const parts = combo.name.split(' + ');
            return (
              <div class="flex items-center justify-between group/row relative gap-3">
                <div class="flex items-center gap-1 bg-gray-100 p-1 rounded-lg border border-gray-200 shadow-sm">
                  {parts.map((part, idx) => (
                    <>
                      <div class="relative w-6 h-6 cursor-help group/icon">
                         <img src={`/icons/${getEqIcon(part)}`} alt={part} class="w-full h-full object-contain drop-shadow-sm" onerror="this.style.display='none'" />
                         <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-black/80 text-white text-[10px] font-bold rounded opacity-0 group-hover/icon:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-10">
                          {part}
                        </div>
                      </div>
                      {idx < parts.length - 1 && <span class="text-xs font-black text-gray-400">+</span>}
                    </>
                  ))}
                </div>
                <div class="flex items-center gap-1 sm:gap-2 flex-grow justify-end pl-1 sm:pl-3 min-w-0">
                  <div class="flex-1 h-2.5 bg-gray-200 rounded-full overflow-hidden shadow-inner min-w-[30px]">
                    <div 
                      class="h-full bg-coc-gold rounded-full"
                      style={`width: ${combo.usage}%`}
                    ></div>
                  </div>
                  <div class="text-xs sm:text-sm font-bold text-orange-600 w-8 sm:w-10 text-right flex-shrink-0">{combo.usage}%</div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}
  </div>
</div>
