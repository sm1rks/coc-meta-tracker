---
import type { PlayerData } from '../types';

interface Props {
  players: PlayerData[];
}

const { players = [] } = Astro.props;

import PlayerRow from './PlayerRow.astro';
---
<div class="bg-[#f4e4c1] rounded-2xl shadow-xl border-4 border-[#603813] flex flex-col">
  <div class="bg-gradient-to-r from-blue-500 to-indigo-600 p-4 rounded-t-xl border-b-4 border-black/10 flex items-center gap-4 shrink-0">
    <div class="bg-black/20 text-white rounded-lg p-3 shadow-inner inline-block transform -rotate-3 text-3xl leading-none w-16 h-16 flex items-center justify-center">🏆</div>
    <div class="min-w-0">
      <h2 class="text-2xl xl:text-3xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">Global Top 200</h2>
      <p class="text-blue-100 font-bold text-sm tracking-wide">Current Season Rankings & Compositions</p>
    </div>
  </div>
  
  <div class="p-0 flex-1 relative">
    <div class="p-4">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-4">
        <input type="text" id="player-search" placeholder="Search players..." class="w-full sm:w-64 px-4 py-2 rounded-lg border-2 border-gray-200 focus:border-blue-500 focus:outline-none shadow-sm" />
        <div class="flex items-center gap-2" id="pagination-controls">
          <button id="prev-page" class="px-3 py-1.5 bg-white border border-gray-300 rounded hover:bg-gray-50 disabled:opacity-50 text-sm font-bold shadow-sm">Previous</button>
          <span id="page-info" class="text-sm font-bold text-gray-600">Page 1 of 1</span>
          <button id="next-page" class="px-3 py-1.5 bg-white border border-gray-300 rounded hover:bg-gray-50 disabled:opacity-50 text-sm font-bold shadow-sm">Next</button>
        </div>
      </div>
      <div class="w-full" id="players-table-wrapper">
        <!-- Table Header -->
        <div class="flex items-center text-xs font-black text-gray-500 uppercase tracking-widest px-3 pb-2 border-b-2 border-gray-200/50 mb-2 hidden md:flex">
          <div class="w-1/4 min-w-[200px] mr-3">Player / Trophies & Rank</div>
          <div class="flex-1">Army Composition</div>
        </div>
        
        <div id="players-list" class="space-y-2">
          {players.map(player => (
            <PlayerRow player={player} theme="blue" />
          ))}
          {players.length === 0 && <div class="text-gray-400 text-sm italic p-4 text-center">No players found.</div>}
          <div id="search-no-results" class="text-gray-500 font-bold text-sm italic p-6 text-center hidden">No matching players found.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const playersList = document.getElementById('players-list');
    if (!playersList) {
      // Clear any 'display: none' styles that Astro's View Transitions (morphdom) 
      // might have accidentally preserved when navigating away from the Top 200 page.
      const strayRows = Array.from(document.querySelectorAll('.player-row')) as HTMLElement[];
      strayRows.forEach(row => row.style.display = '');
      return; 
    }

    const searchInput = document.getElementById('player-search') as HTMLInputElement;
    const prevBtn = document.getElementById('prev-page') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-page') as HTMLButtonElement;
    const pageInfo = document.getElementById('page-info');
    const rows = Array.from(playersList.querySelectorAll('.player-row')) as HTMLElement[];
    const noResultsEl = document.getElementById('search-no-results');
    
    let currentPage = 1;
    const itemsPerPage = 20;
    let filteredRows = [...rows];

    const render = () => {
      const totalPages = Math.ceil(filteredRows.length / itemsPerPage) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      if (pageInfo) pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
      if (prevBtn) prevBtn.disabled = currentPage === 1;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages;

      if (noResultsEl) {
        if (filteredRows.length === 0) {
          noResultsEl.classList.remove('hidden');
        } else {
          noResultsEl.classList.add('hidden');
        }
      }

      const startIdx = (currentPage - 1) * itemsPerPage;
      const endIdx = startIdx + itemsPerPage;

      // Hide all first
      rows.forEach(row => row.style.display = 'none');

      // Show only filtered and paginated using flex
      filteredRows.slice(startIdx, endIdx).forEach(row => {
        row.style.display = 'flex';
      });
      
      // Update URL query params
      const url = new URL(window.location.href);
      if (searchInput.value) url.searchParams.set('search', searchInput.value);
      else url.searchParams.delete('search');
      if (currentPage > 1) url.searchParams.set('page', currentPage.toString());
      else url.searchParams.delete('page');
      window.history.replaceState({}, '', url);
    };

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        filteredRows = rows.filter(row => {
          const name = row.getAttribute('data-name') || '';
          return name.includes(query);
        });
        currentPage = 1;
        render();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          render();
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage) || 1;
        if (currentPage < totalPages) {
          currentPage++;
          render();
        }
      });
    }

    // Initialize from URL
    const urlParams = new URLSearchParams(window.location.search);
    const searchParam = urlParams.get('search');
    const pageParam = urlParams.get('page');
    
    if (searchParam && searchInput) {
      searchInput.value = searchParam;
      filteredRows = rows.filter(row => (row.getAttribute('data-name') || '').includes(searchParam.toLowerCase()));
    }
    if (pageParam) {
      currentPage = parseInt(pageParam) || 1;
    }
    
    render();
  });
</script>

<style>
  #players-list .player-row:nth-child(n+21) {
    display: none;
  }
</style>
