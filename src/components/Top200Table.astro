---
interface Props {
  players: {
    rank: number;
    name: string;
    tag: string;
    trophies: number;
    clanName: string;
    clanBadge: string;
    armyType: string;
    heroes?: { hero: string, combo: string|null, pet: string|null }[];
    siegeMachine?: string | null;
    superTroops?: string[];
    armyLink?: string;
  }[];
}

const { players } = Astro.props;
import { getHeroIcon, getEqIcon, getPetIcon, getSuperTroopIcon, getSiegeMachineIcon } from '../utils/iconUtils';
---
<div class="bg-[#f4e4c1] rounded-2xl shadow-xl border-4 border-[#603813] flex flex-col h-full overflow-hidden">
  <div class="bg-gradient-to-r from-blue-500 to-indigo-600 p-4 rounded-t-xl border-b-4 border-black/10 flex items-center gap-4 shrink-0">
    <div class="bg-black/20 text-white rounded-lg p-3 shadow-inner inline-block transform -rotate-3 text-3xl leading-none w-16 h-16 flex items-center justify-center">🏆</div>
    <div class="min-w-0">
      <h2 class="text-2xl xl:text-3xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">Global Top 200</h2>
      <p class="text-blue-100 font-bold text-sm tracking-wide">Current Season Rankings & Compositions</p>
    </div>
  </div>
  
  <div class="p-0 flex-1 relative min-h-[600px] overflow-hidden">
    <div class="absolute inset-0 overflow-y-auto p-4 custom-scrollbar">
      <div class="w-full">
        <!-- Table Header -->
        <div class="flex items-center text-xs font-black text-gray-500 uppercase tracking-widest px-3 pb-2 border-b-2 border-gray-200/50 mb-2 hidden md:flex">
          <div class="w-12 text-center shrink-0 mr-4">Rank</div>
          <div class="w-1/3 min-w-[200px]">Player</div>
          <div class="flex-1">Army Composition</div>
          <div class="w-24 text-right pr-4">Trophies</div>
        </div>
        
        <div class="space-y-2">
          {players.map(player => (
            <div class="flex flex-col md:flex-row items-center justify-between group gap-2 md:gap-4 bg-gray-50 hover:bg-white p-3 rounded-xl border-2 border-transparent hover:border-blue-200 hover:shadow-md transition-all">
              
              <!-- Rank & Player Info -->
              <div class="flex items-center gap-4 w-full md:w-1/3 min-w-[200px] shrink-0">
                <div class="font-black text-gray-400 w-12 text-center text-lg shrink-0">#{player.rank}</div>
                <div class="flex-1 min-w-0 flex items-center gap-3">
                  {player.clanBadge ? (
                    <img src={player.clanBadge} alt={player.clanName} loading="lazy" decoding="async" class="w-8 h-8 object-contain drop-shadow-md shrink-0" onerror="this.style.display='none'" />
                  ) : (
                    <div class="w-8 h-8 shrink-0 flex items-center justify-center bg-gray-200 rounded-full text-xs font-bold text-gray-500">-</div>
                  )}
                  <div class="truncate min-w-0">
                    <div class="font-black text-base text-gray-800 truncate">{player.name}</div>
                    {player.clanName && <div class="text-xs font-bold text-blue-600 truncate">{player.clanName}</div>}
                  </div>
                </div>
              </div>
              
              <!-- Army Composition -->
              <div class="flex-1 min-w-0 w-full md:w-auto bg-gray-100/50 rounded-lg p-2 md:px-4 md:py-2 border border-gray-200/50 relative group/army">
                <div class="text-[10px] uppercase font-bold tracking-widest text-gray-400 mb-0.5 md:hidden">Army</div>
                <div class="flex items-center gap-2">
                  <div class="font-black text-sm text-gray-700">{player.armyType}</div>
                  {player.armyLink && (
                    <button 
                      onclick={`navigator.clipboard.writeText('${player.armyLink}')`}
                      class="bg-blue-100 hover:bg-blue-200 text-blue-600 text-[10px] font-bold px-2 py-0.5 rounded cursor-pointer border border-blue-200"
                      title="Copy Army Link"
                    >
                      COPY LINK
                    </button>
                  )}
                </div>
                <div class="flex items-center gap-2 mt-1.5 flex-wrap">
                  {player.siegeMachine && (
                    <div class="relative group/icon cursor-help w-6 h-6 rounded bg-orange-100 border border-orange-200 shadow-sm">
                      <div class="w-full h-full overflow-hidden rounded">
                        <img src={getSiegeMachineIcon(player.siegeMachine)} alt={player.siegeMachine} loading="lazy" decoding="async" class="w-full h-full object-contain scale-110" onerror="this.style.display='none'" />
                      </div>
                      <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-black/80 text-white text-[10px] font-bold rounded opacity-0 group-hover/icon:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-50 shadow-lg">{player.siegeMachine}</div>
                    </div>
                  )}
                  {player.superTroops && player.superTroops.map(t => (
                    <div class="relative group/icon cursor-help w-6 h-6 rounded bg-gray-100 border border-gray-200 shadow-sm">
                      <div class="w-full h-full overflow-hidden rounded">
                        <img src={getSuperTroopIcon(t)} alt={t} loading="lazy" decoding="async" class="w-full h-full object-cover scale-110" onerror="this.style.display='none'" />
                      </div>
                      <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-black/80 text-white text-[10px] font-bold rounded opacity-0 group-hover/icon:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-50 shadow-lg">{t}</div>
                    </div>
                  ))}
                  {player.heroes && player.heroes.map(h => (
                    <div class="flex items-center bg-white rounded border border-gray-200 shadow-sm h-6">
                      <div class="relative group/icon cursor-help w-6 h-6 bg-gradient-to-b from-gray-100 to-gray-300 shrink-0 rounded-l">
                        <div class="w-full h-full overflow-hidden rounded-l">
                          <img src={getHeroIcon(h.hero)} alt={h.hero} loading="lazy" decoding="async" class={`w-full h-full object-cover scale-110 ${h.hero === 'Grand Warden' ? 'object-top' : ''}`} onerror="this.style.display='none'" />
                        </div>
                        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-black/80 text-white text-[10px] font-bold rounded opacity-0 group-hover/icon:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-50 shadow-lg">{h.hero}</div>
                      </div>
                      {h.pet && (
                        <div class="relative group/icon cursor-help w-5 h-5 bg-gradient-to-b from-purple-50 to-purple-200 shrink-0 border-l border-gray-200">
                          <div class="w-full h-full overflow-hidden">
                            <img src={getPetIcon(h.pet)} alt={h.pet} loading="lazy" decoding="async" class="w-full h-full object-cover scale-110" onerror="this.style.display='none'" />
                          </div>
                          <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-black/80 text-white text-[10px] font-bold rounded opacity-0 group-hover/icon:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-50 shadow-lg">{h.pet}</div>
                        </div>
                      )}
                      {h.combo && h.combo.split(' + ').map((eq, idx, arr) => (
                        <div class={`relative group/icon cursor-help w-5 h-5 bg-gradient-to-b from-amber-50 to-amber-100 shrink-0 border-l border-gray-200 ${!h.pet && idx === arr.length - 1 ? 'rounded-r' : ''}`}>
                          <div class={`w-full h-full overflow-hidden ${!h.pet && idx === arr.length - 1 ? 'rounded-r' : ''}`}>
                            <img src={getEqIcon(eq)} alt={eq} loading="lazy" decoding="async" class="w-full h-full object-cover scale-110" onerror="this.style.display='none'" />
                          </div>
                          <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-black/80 text-white text-[10px] font-bold rounded opacity-0 group-hover/icon:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-50 shadow-lg">{eq}</div>
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
              
              <!-- Trophies -->
              <div class="flex items-center justify-between w-full md:w-24 shrink-0 bg-yellow-100 px-3 py-1.5 rounded-lg border-2 border-yellow-300">
                <span class="text-xs font-black text-yellow-700 md:hidden uppercase tracking-wider">Trophies</span>
                <div class="flex items-center gap-1 ml-auto">
                  <span class="text-sm font-black text-yellow-700">{player.trophies}</span>
                  <span class="text-sm">🏆</span>
                </div>
              </div>
              
            </div>
          ))}
          {players.length === 0 && <div class="text-gray-400 text-sm italic p-4 text-center">No players found.</div>}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }
</style>
