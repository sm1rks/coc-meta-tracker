---
import type { PlayerData } from '../types';
import PlayerRow from './PlayerRow.astro';
import { getCoreArmyName } from '../utils/dataUtils';

interface Props {
  players: PlayerData[];
}

const { players = [] } = Astro.props;

const armyCounts = new Map<string, number>();
for (const p of players) {
  if (p.armyType && p.armyType !== 'Unknown') {
    const coreName = getCoreArmyName(p.armyType);
    if (coreName !== 'Unknown') {
      armyCounts.set(coreName, (armyCounts.get(coreName) || 0) + 1);
    }
  }
}
const armyOptions = Array.from(armyCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));
---
<div id="top200-card" class="bg-[#603813] rounded-2xl shadow-xl border-4 border-[#603813] flex flex-col overflow-hidden">
  <div class="bg-gradient-to-r from-blue-600 to-indigo-600 p-3 border-b-4 border-black/15 flex items-center gap-3 shrink-0">
    <div class="w-12 h-12 flex items-center justify-center text-3xl leading-none drop-shadow-lg shrink-0 select-none" role="img" aria-label="Trophy">🏆</div>
    <div class="min-w-0">
      <h2 class="text-lg xl:text-xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">Global Top 200</h2>
    </div>
  </div>
  
  <div class="bg-[#f4e4c1] p-0 flex-1 relative">
    <div class="p-3 sm:p-4">
      <!-- Top Toolbar: Search + Army Filter + Pagination -->
      <div class="flex flex-col lg:flex-row justify-between items-stretch lg:items-center gap-3 mb-2.5 bg-[#e6d1a7]/60 p-2.5 rounded-xl border border-[#c4a481]/80">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 flex-1">
          <div class="relative flex-1 sm:max-w-sm">
            <svg class="w-4 h-4 text-[#603813]/60 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input 
              type="search" 
              inputmode="search" 
              id="player-search" 
              aria-label="Search players by name, clan, or tag" 
              placeholder="Search player, clan, troop, equip, pet, spell..." 
              class="w-full pl-9 pr-3 py-1.5 rounded-lg bg-[#fbf6ea] border border-[#c4a481] text-[#4a2e0f] placeholder-[#603813]/60 focus:border-[#603813] focus:bg-white focus-visible:outline-2 focus-visible:outline-[#603813] shadow-2xs text-xs sm:text-sm font-bold transition-colors" 
            />
          </div>

          {armyOptions.length > 0 && (
            <select 
              id="army-filter" 
              aria-label="Filter players by army type"
              class="px-3 py-1.5 rounded-lg bg-[#fbf6ea] border border-[#c4a481] text-[#4a2e0f] focus:border-[#603813] focus:bg-white focus-visible:outline-2 focus-visible:outline-[#603813] shadow-2xs text-xs sm:text-sm font-bold cursor-pointer transition-colors sm:max-w-[260px] truncate"
            >
              <option value="">All Armies ({players.length})</option>
              {armyOptions.map(opt => (
                <option value={opt.name.toLowerCase()}>{opt.name} ({opt.count})</option>
              ))}
            </select>
          )}

          <select
            id="player-sort"
            aria-label="Sort players"
            class="px-2.5 py-1.5 rounded-lg bg-[#fbf6ea] border border-[#c4a481] text-[#4a2e0f] focus:border-[#603813] focus:bg-white focus-visible:outline-2 focus-visible:outline-[#603813] shadow-2xs text-xs sm:text-sm font-bold cursor-pointer transition-colors shrink-0"
          >
            <option value="rank">Sort: Rank</option>
            <option value="atk-rate">Sort: 3★ Rate</option>
            <option value="prev-rank">Sort: Prev Rank</option>
          </select>

          <button
            type="button"
            id="clear-filters"
            class="hidden px-2.5 py-1.5 rounded-lg bg-[#603813]/10 hover:bg-[#603813]/20 text-[#4a2e0f] border border-[#c4a481] text-xs font-black uppercase tracking-wide cursor-pointer transition-colors shrink-0 focus-visible:outline-2 focus-visible:outline-[#603813]"
          >
            Clear
          </button>
        </div>

        <div class="flex items-center justify-between sm:justify-end gap-2 shrink-0" id="pagination-controls">
          <button type="button" id="prev-page" aria-label="Previous page" class="px-3 py-1.5 bg-[#fbf6ea] border border-[#c4a481] text-[#603813] rounded-lg hover:bg-white disabled:opacity-40 disabled:pointer-events-none text-xs sm:text-sm font-black shadow-2xs transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-[#603813]">Previous</button>
          <span id="page-info" class="text-xs sm:text-sm font-black text-[#603813] px-1 tabular-nums">Page 1 of 1</span>
          <button type="button" id="next-page" aria-label="Next page" class="px-3 py-1.5 bg-[#fbf6ea] border border-[#c4a481] text-[#603813] rounded-lg hover:bg-white disabled:opacity-40 disabled:pointer-events-none text-xs sm:text-sm font-black shadow-2xs transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-[#603813]">Next</button>
        </div>
      </div>

      <div id="results-summary" aria-live="polite" class="text-[11px] font-bold text-[#603813]/80 mb-2.5 px-1 tabular-nums">
        Showing {Math.min(20, players.length)} of {players.length} players
      </div>

      <!-- Players List -->
      <div class="w-full" id="players-table-wrapper">
        <div id="players-list" class="space-y-2.5">
          {players.map(player => (
            <PlayerRow player={player} />
          ))}
          {players.length === 0 && <div class="text-[#603813]/70 text-sm italic p-4 text-center">No players found.</div>}
          <div id="search-no-results" class="text-[#603813]/80 font-bold text-sm p-6 text-center hidden space-y-2">
            <div>No matching players found.</div>
            <button type="button" id="clear-filters-empty" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-amber-100 hover:bg-amber-200 text-[#603813] border border-[#c4a481] text-xs font-black uppercase cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-[#603813]">
              Clear Filters
            </button>
          </div>
        </div>
      </div>

      <!-- Bottom Pagination Controls -->
      <div id="bottom-pagination" class="flex items-center justify-between sm:justify-end gap-2 mt-4 pt-3 border-t border-[#c4a481]/60">
        <button type="button" id="prev-page-bottom" aria-label="Previous page" class="px-3 py-1.5 bg-[#fbf6ea] border border-[#c4a481] text-[#603813] rounded-lg hover:bg-white disabled:opacity-40 disabled:pointer-events-none text-xs sm:text-sm font-black shadow-2xs transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-[#603813]">Previous</button>
        <span id="page-info-bottom" class="text-xs sm:text-sm font-black text-[#603813] px-1 tabular-nums">Page 1 of 1</span>
        <button type="button" id="next-page-bottom" aria-label="Next page" class="px-3 py-1.5 bg-[#fbf6ea] border border-[#c4a481] text-[#603813] rounded-lg hover:bg-white disabled:opacity-40 disabled:pointer-events-none text-xs sm:text-sm font-black shadow-2xs transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-[#603813]">Next</button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const playersList = document.getElementById('players-list');
    if (!playersList) {
      const strayRows = Array.from(document.querySelectorAll('.player-row')) as HTMLElement[];
      strayRows.forEach(row => row.style.display = '');
      return; 
    }

    const searchInput = document.getElementById('player-search') as HTMLInputElement | null;
    const armyFilter = document.getElementById('army-filter') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('player-sort') as HTMLSelectElement | null;
    const clearBtn = document.getElementById('clear-filters') as HTMLButtonElement | null;
    const clearBtnEmpty = document.getElementById('clear-filters-empty') as HTMLButtonElement | null;
    const resultsSummary = document.getElementById('results-summary');
    const prevBtn = document.getElementById('prev-page') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('next-page') as HTMLButtonElement | null;
    const pageInfo = document.getElementById('page-info');
    const prevBtnBottom = document.getElementById('prev-page-bottom') as HTMLButtonElement | null;
    const nextBtnBottom = document.getElementById('next-page-bottom') as HTMLButtonElement | null;
    const pageInfoBottom = document.getElementById('page-info-bottom');
    const bottomPagination = document.getElementById('bottom-pagination');
    const top200Card = document.getElementById('top200-card');
    const noResultsEl = document.getElementById('search-no-results');

    const indexedRows = (Array.from(playersList.querySelectorAll('.player-row')) as HTMLElement[]).map(el => ({
      el,
      coreArmy: (el.getAttribute('data-core-army') || '').toLowerCase(),
      searchBlob: (el.getAttribute('data-search') || '').toLowerCase(),
      rank: parseInt(el.getAttribute('data-rank') || '999999', 10),
      atkRate: parseFloat(el.getAttribute('data-atk-rate') || '-1'),
      prevRank: parseInt(el.getAttribute('data-prev-rank') || '999999', 10),
    }));
    
    let currentPage = 1;
    const itemsPerPage = 20;
    let filteredRows = indexedRows;

    const matchesFilters = (item: { coreArmy: string; searchBlob: string }, q: string, selectedArmy: string) => {
      if (selectedArmy && item.coreArmy !== selectedArmy) return false;
      if (!q) return true;
      if (item.searchBlob.includes(q)) return true;
      const tokens = q.split(/[\s,]+/).filter(Boolean);
      return tokens.every(token => item.searchBlob.includes(token));
    };

    const applyFilters = () => {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const selectedArmy = (armyFilter?.value || '').toLowerCase().trim();
      const sortBy = sortSelect?.value || 'rank';

      filteredRows = (!q && !selectedArmy)
        ? [...indexedRows]
        : indexedRows.filter(item => matchesFilters(item, q, selectedArmy));

      filteredRows.sort((a, b) => {
        if (sortBy === 'atk-rate') {
          if (b.atkRate !== a.atkRate) return b.atkRate - a.atkRate;
          return a.rank - b.rank;
        }
        if (sortBy === 'prev-rank') {
          if (a.prevRank !== b.prevRank) return a.prevRank - b.prevRank;
          return a.rank - b.rank;
        }
        return a.rank - b.rank;
      });

      if (clearBtn) {
        clearBtn.classList.toggle('hidden', !q && !selectedArmy && sortBy === 'rank');
      }
    };

    const render = (scrollToTop = false) => {
      const totalItems = filteredRows.length;
      const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const label = `Page ${currentPage} of ${totalPages}`;
      if (pageInfo) pageInfo.textContent = label;
      if (pageInfoBottom) pageInfoBottom.textContent = label;
      if (prevBtn) prevBtn.disabled = currentPage === 1;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages;
      if (prevBtnBottom) prevBtnBottom.disabled = currentPage === 1;
      if (nextBtnBottom) nextBtnBottom.disabled = currentPage === totalPages;

      if (bottomPagination) {
        bottomPagination.style.display = totalItems > 0 ? 'flex' : 'none';
      }

      if (noResultsEl) {
        noResultsEl.classList.toggle('hidden', totalItems > 0);
      }

      const startIdx = (currentPage - 1) * itemsPerPage;
      const endIdx = Math.min(startIdx + itemsPerPage, totalItems);

      if (resultsSummary) {
        const isFiltered = Boolean(searchInput?.value.trim() || armyFilter?.value);
        if (totalItems === 0) {
          resultsSummary.textContent = '0 matching players';
        } else {
          resultsSummary.textContent = `Showing ${startIdx + 1}–${endIdx} of ${totalItems}${isFiltered ? ' matching' : ''} players`;
        }
      }

      for (const item of indexedRows) {
        item.el.style.display = 'none';
      }

      for (let i = startIdx; i < endIdx; i++) {
        const rowEl = filteredRows[i].el;
        playersList.appendChild(rowEl);
        rowEl.style.display = 'flex';
      }
      if (noResultsEl) playersList.appendChild(noResultsEl);
      
      const url = new URL(window.location.href);
      if (searchInput?.value) url.searchParams.set('search', searchInput.value);
      else url.searchParams.delete('search');
      if (armyFilter?.value) url.searchParams.set('army', armyFilter.value);
      else url.searchParams.delete('army');
      if (sortSelect?.value && sortSelect.value !== 'rank') url.searchParams.set('sort', sortSelect.value);
      else url.searchParams.delete('sort');
      if (currentPage > 1) url.searchParams.set('page', currentPage.toString());
      else url.searchParams.delete('page');
      window.history.replaceState({}, '', url);

      if (scrollToTop && top200Card) {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        top200Card.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });
      }
    };

    const resetFilters = () => {
      if (searchInput) searchInput.value = '';
      if (armyFilter) armyFilter.value = '';
      if (sortSelect) sortSelect.value = 'rank';
      applyFilters();
      currentPage = 1;
      render();
      searchInput?.focus();
    };

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        applyFilters();
        currentPage = 1;
        render();
      });
    }

    if (armyFilter) {
      armyFilter.addEventListener('change', () => {
        applyFilters();
        currentPage = 1;
        render();
      });
    }

    sortSelect?.addEventListener('change', () => {
      applyFilters();
      currentPage = 1;
      render();
    });

    clearBtn?.addEventListener('click', resetFilters);
    clearBtnEmpty?.addEventListener('click', resetFilters);

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        render();
      }
    });

    nextBtn?.addEventListener('click', () => {
      const totalPages = Math.ceil(filteredRows.length / itemsPerPage) || 1;
      if (currentPage < totalPages) {
        currentPage++;
        render();
      }
    });

    prevBtnBottom?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        render(true);
      }
    });

    nextBtnBottom?.addEventListener('click', () => {
      const totalPages = Math.ceil(filteredRows.length / itemsPerPage) || 1;
      if (currentPage < totalPages) {
        currentPage++;
        render(true);
      }
    });

    const urlParams = new URLSearchParams(window.location.search);
    const searchParam = urlParams.get('search');
    const armyParam = urlParams.get('army');
    const sortParam = urlParams.get('sort');
    const pageParam = urlParams.get('page');
    
    if (searchParam && searchInput) {
      searchInput.value = searchParam;
    }
    if (armyParam && armyFilter) {
      armyFilter.value = armyParam.toLowerCase();
    }
    if (sortParam && sortSelect) {
      sortSelect.value = sortParam;
    }
    applyFilters();
    if (pageParam) {
      currentPage = parseInt(pageParam, 10) || 1;
    }
    
    render();
  });
</script>

<style>
  #players-list .player-row:nth-child(n+21) {
    display: none;
  }
</style>
