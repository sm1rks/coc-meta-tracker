---
import { getSiegeMachineIcon, basePath } from '../utils/iconUtils';
import TrendBadge from './TrendBadge.astro';

interface Props {
  machines: {
    name: string;
    usage: number;
    usageDelta?: number;
    threeStarCount?: number;
    threeStarRate?: number;
  }[];
}

const { machines } = Astro.props;
const activeMachines = machines.filter(m => m.usage > 0);
const displayedMachines = activeMachines.length > 0 ? activeMachines : machines;
const clampPct = (val: number) => Math.min(100, Math.max(0, val));
---
<div class="bg-[#603813] rounded-2xl shadow-xl border-4 border-[#603813] overflow-hidden transition-transform duration-200 hover:scale-[1.01] motion-reduce:transition-none motion-reduce:hover:scale-100 flex flex-col h-full relative z-0 hover:z-10">
  <div class="bg-gradient-to-r from-orange-500 to-red-600 p-3 border-b-4 border-black/15 flex items-center gap-3 shrink-0">
    <img src={`${basePath}icons/Siege_Machine_HV_Wall_Wrecker_3.webp`} alt="Siege Machines" width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 object-contain drop-shadow-lg shrink-0" />
    <div class="min-w-0">
      <h2 class="text-lg xl:text-xl font-black text-white drop-shadow-md leading-tight whitespace-nowrap tracking-tighter uppercase">Siege Machines</h2>
    </div>
  </div>
  
  <div class="bg-[#f4e4c1] px-4 py-4 flex-1 flex flex-col justify-center">
    <div class="space-y-2.5">
      {displayedMachines.map(machine => (
        <div class="flex items-center justify-between group/row relative gap-3">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 flex-shrink-0 cursor-help rounded-lg overflow-hidden border border-[#c4a481] shadow-sm bg-white/60" data-tooltip={machine.name}>
              <img 
                src={getSiegeMachineIcon(machine.name)} 
                alt={machine.name}
                width="32"
                height="32"
                loading="lazy"
                decoding="async"
                class="unit-img"
              />
            </div>
          </div>
          
          <div class="flex items-center gap-2 flex-grow justify-end min-w-0">
            <div class="flex-1 h-3 bg-[#603813]/12 rounded-full overflow-hidden shadow-inner border border-[#603813]/15 min-w-[40px]">
              <div 
                class="h-full bg-gradient-to-r from-orange-500 to-red-500 rounded-full shadow-sm"
                style={`width: ${clampPct(machine.usage)}%`}
              ></div>
            </div>
            <div class="flex flex-col items-end w-13 shrink-0 leading-tight">
              <span class="text-xs sm:text-sm font-black text-orange-800 tabular-nums">{machine.usage.toFixed(1)}%</span>
              <div class="flex items-center gap-1">
                {machine.threeStarRate !== undefined && (
                  <span class="text-[9px] font-black text-amber-800 tabular-nums cursor-help" data-tooltip={`${machine.threeStarRate.toFixed(1)}% 3-Star Rate`}>
                    ★{machine.threeStarRate.toFixed(0)}%
                  </span>
                )}
                <TrendBadge delta={machine.usageDelta} />
              </div>
            </div>
          </div>
        </div>
      ))}
      {displayedMachines.length === 0 && <div class="text-[#603813]/65 text-sm italic">No active siege machines found.</div>}
    </div>
  </div>
</div>
